// Función para verificar productos escaneados desde el escáner
function checkScannedProduct() {
    const scannedProduct = sessionStorage.getItem('scannedProduct');
    if (scannedProduct) {
        try {
            const product = JSON.parse(scannedProduct);
            // Verificar que no haya expirado (5 minutos máximo)
            if (Date.now() - product.timestamp < 5 * 60 * 1000) {
                // Agregar automáticamente al carrito
                const existing = cart.find(item => item.id === product.id);
                if (existing) {
                    existing.quantity += 1;
                } else {
                    cart.push({
                        id: product.id,
                        nombre: product.nombre,
                        precio: product.precio,
                        codigo: product.codigo,
                        quantity: 1
                    });
                }
                updateCart();
                showAlert(`✅ "${product.nombre}" escaneado y agregado al carrito`, 'success');
            }
            sessionStorage.removeItem('scannedProduct');
        } catch (e) {
            console.error('Error procesando producto escaneado:', e);
            sessionStorage.removeItem('scannedProduct');
        }
    }
}

