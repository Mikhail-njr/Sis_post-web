// alert('Script loaded');

// Variables globales
let cart = [];
let selectedProduct = null;
let selectedPaymentMethod = null;
// isLoggedIn and authCredentials are declared in shared/auth.js
// API_BASE and formatCurrency are declared in shared/api-client.js

// Sistema de carga centralizada con indicadores globales de carga
const LoadingSystem = {
    // Estados de carga globales
    globalLoading: false,
    activeOperations: new Set(),
    operationQueue: [],

    // Indicadores de carga por sección
    sectionLoaders: new Map(),

    // Sistema de caché inteligente con invalidación
    cache: {
        data: new Map(),
        timestamps: new Map(),
        versions: new Map(),
        CACHE_DURATION: 5 * 60 * 1000, // 5 minutos
        CACHE_KEY_PREFIX: 'dashboard_cache_',

        // Verificar si datos en caché son válidos
        isValid(key) {
            const timestamp = this.timestamps.get(key);
            if (!timestamp) return false;
            return (Date.now() - timestamp) < this.CACHE_DURATION;
        },

        // Obtener datos del caché
        get(key) {
            if (this.isValid(key)) {
                console.log(`✅ Usando datos de ${key} desde caché`);
                return this.data.get(key);
            }
            return null;
        },

        // Almacenar datos en caché
        set(key, data, version = null) {
            try {
                this.data.set(key, JSON.parse(JSON.stringify(data)));
                this.timestamps.set(key, Date.now());
                this.versions.set(key, version || Date.now());

                // Persistencia en localStorage
                const cacheData = {
                    data: this.data.get(key),
                    timestamp: this.timestamps.get(key),
                    version: this.versions.get(key)
                };

                try {
                    localStorage.setItem(`${this.CACHE_KEY_PREFIX}${key}`, JSON.stringify(cacheData));
                } catch (storageError) {
                    console.warn(`⚠️ Error guardando ${key} en localStorage:`, storageError);
                }

                console.log(`💾 Datos de ${key} almacenados en caché`);
            } catch (error) {
                console.error(`Error almacenando ${key} en caché:`, error);
            }
        },

        // Cargar desde localStorage
        loadFromStorage(key) {
            try {
                const stored = localStorage.getItem(`${this.CACHE_KEY_PREFIX}${key}`);
                if (stored) {
                    const cacheData = JSON.parse(stored);
                    const now = Date.now();

                    if (cacheData.timestamp && (now - cacheData.timestamp) < this.CACHE_DURATION) {
                        this.data.set(key, cacheData.data);
                        this.timestamps.set(key, cacheData.timestamp);
                        this.versions.set(key, cacheData.version);
                        console.log(`📦 Datos de ${key} cargados desde localStorage`);
                        return true;
                    } else {
                        this.clear(key);
                    }
                }
            } catch (error) {
                console.warn(`Error cargando caché de ${key}:`, error);
                this.clear(key);
            }
            return false;
        },

        // Limpiar caché específico
        clear(key) {
            this.data.delete(key);
            this.timestamps.delete(key);
            this.versions.delete(key);
            try {
                localStorage.removeItem(`${this.CACHE_KEY_PREFIX}${key}`);
                console.log(`🗑️ Caché de ${key} limpiado`);
            } catch (error) {
                console.warn(`Error limpiando localStorage para ${key}:`, error);
            }
        },

        // Invalidar caché
        invalidate(key) {
            if (key) {
                this.timestamps.set(key, 0);
            } else {
                // Invalidar todo
                for (const k of this.data.keys()) {
                    this.timestamps.set(k, 0);
                }
            }
        },

        // Verificar si necesita actualización
        needsUpdate(key, serverVersion) {
            const localVersion = this.versions.get(key);
            if (!localVersion || !serverVersion) return true;
            return localVersion < serverVersion;
        }
    },

    // Flags de sincronización para prevenir llamadas API concurrentes
    syncFlags: new Map(),

    // Inicializar sistema de carga
    init() {
        this.createGlobalLoader();
        this.loadPersistedCache();
    },

    // Crear indicador de carga global
    createGlobalLoader() {
        if (document.getElementById('global-loading-overlay')) return;

        const overlay = document.createElement('div');
        overlay.id = 'global-loading-overlay';
        overlay.style.cssText = `
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            backdrop-filter: blur(2px);
        `;

        overlay.innerHTML = `
            <div style="text-align: center; color: white;">
                <div style="font-size: 48px; margin-bottom: 20px;">⏳</div>
                <div style="font-size: 18px; margin-bottom: 10px;" id="global-loading-text">Cargando...</div>
                <div style="font-size: 14px; opacity: 0.8;" id="global-loading-detail">Preparando datos del dashboard</div>
                <div style="margin-top: 20px;">
                    <div style="width: 200px; height: 4px; background: #333; border-radius: 2px; overflow: hidden;">
                        <div id="global-loading-progress" style="width: 0%; height: 100%; background: linear-gradient(90deg, #007bff, #28a745); border-radius: 2px; transition: width 0.3s ease;"></div>
                    </div>
                </div>
            </div>
        `;

        document.body.appendChild(overlay);
    },

    // Mostrar indicador de carga global
    showGlobalLoader(text = 'Cargando...', detail = '') {
        const overlay = document.getElementById('global-loading-overlay');
        const textEl = document.getElementById('global-loading-text');
        const detailEl = document.getElementById('global-loading-detail');

        if (overlay) {
            overlay.style.display = 'flex';
            this.globalLoading = true;
        }

        if (textEl) textEl.textContent = text;
        if (detailEl) detailEl.textContent = detail;
    },

    // Ocultar indicador de carga global
    hideGlobalLoader() {
        const overlay = document.getElementById('global-loading-overlay');
        if (overlay) {
            overlay.style.display = 'none';
            this.globalLoading = false;
        }
    },

    // Actualizar progreso global
    updateGlobalProgress(percentage) {
        const progressEl = document.getElementById('global-loading-progress');
        if (progressEl) {
            progressEl.style.width = Math.min(100, Math.max(0, percentage)) + '%';
        }
    },

    // Crear indicador de carga para sección específica
    createSectionLoader(sectionId, text = 'Cargando...') {
        const section = document.getElementById(sectionId);
        if (!section) return null;

        const existing = section.querySelector('.section-loader');
        if (existing) return existing;

        const loader = document.createElement('div');
        loader.className = 'section-loader';
        loader.style.cssText = `
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            margin: 10px 0;
            border: 1px solid rgba(255, 255, 255, 0.1);
        `;

        loader.innerHTML = `
            <div style="text-align: center; color: #666;">
                <div style="font-size: 24px; margin-bottom: 10px;">⏳</div>
                <div style="font-size: 14px;">${text}</div>
            </div>
        `;

        section.appendChild(loader);
        this.sectionLoaders.set(sectionId, loader);
        return loader;
    },

    // Mostrar/ocultar loader de sección
    showSectionLoader(sectionId, show = true) {
        const loader = this.sectionLoaders.get(sectionId);
        if (loader) {
            loader.style.display = show ? 'flex' : 'none';
        }
    },

    // Cargar caché persistido al iniciar
    loadPersistedCache() {
        // Cargar datos críticos del dashboard
        this.cache.loadFromStorage('dashboard');
        this.cache.loadFromStorage('suppliers');
        this.cache.loadFromStorage('supplierOrders');
    },

    // Ejecutar operación con sincronización
    async executeOperation(operationId, operation, options = {}) {
        const {
            allowConcurrent = false,
            showGlobalLoader = false,
            globalLoaderText = 'Procesando...',
            sectionLoader = null,
            useCache = true,
            cacheKey = operationId,
            forceRefresh = false
        } = options;

        // Verificar sincronización
        if (!allowConcurrent && this.syncFlags.get(operationId)) {
            console.log(`🔄 Operación ${operationId} ya en ejecución, esperando...`);
            return this.syncFlags.get(operationId);
        }

        // Promise para sincronización
        const operationPromise = this._executeOperationInternal(operationId, operation, {
            showGlobalLoader,
            globalLoaderText,
            sectionLoader,
            useCache,
            cacheKey,
            forceRefresh
        });

        if (!allowConcurrent) {
            this.syncFlags.set(operationId, operationPromise);
            operationPromise.finally(() => {
                this.syncFlags.delete(operationId);
            });
        }

        return operationPromise;
    },

    // Ejecutar operación internamente
    async _executeOperationInternal(operationId, operation, options) {
        const { showGlobalLoader, globalLoaderText, sectionLoader, useCache, cacheKey, forceRefresh } = options;

        try {
            // Verificar caché primero
            if (useCache && !forceRefresh) {
                const cachedData = this.cache.get(cacheKey);
                if (cachedData !== null) {
                    console.log(`✅ Usando datos cacheados para ${operationId}`);
                    return cachedData;
                }
            }

            // Mostrar indicadores de carga
            if (showGlobalLoader) {
                this.showGlobalLoader(globalLoaderText, `Ejecutando ${operationId}`);
            }
            if (sectionLoader) {
                this.showSectionLoader(sectionLoader, true);
            }

            // Agregar a operaciones activas
            this.activeOperations.add(operationId);

            // Ejecutar operación
            console.log(`🚀 Iniciando operación: ${operationId}`);
            const result = await operation();

            // Cachear resultado si aplica
            if (useCache && result !== undefined) {
                this.cache.set(cacheKey, result);
            }

            console.log(`✅ Operación completada: ${operationId}`);
            return result;

        } catch (error) {
            console.error(`❌ Error en operación ${operationId}:`, error);
            throw error;
        } finally {
            // Limpiar indicadores de carga
            this.activeOperations.delete(operationId);

            if (sectionLoader) {
                this.showSectionLoader(sectionLoader, false);
            }

            // Ocultar loader global solo si no hay más operaciones activas
            if (showGlobalLoader && this.activeOperations.size === 0) {
                this.hideGlobalLoader();
            }
        }
    },

    // Invalidar caché específico
    invalidateCache(key) {
        this.cache.invalidate(key);
        console.log(`🔄 Caché invalidado: ${key}`);
    },

    // Limpiar todo el caché
    clearAllCache() {
        this.cache.data.clear();
        this.cache.timestamps.clear();
        this.cache.versions.clear();

        // Limpiar localStorage
        Object.keys(localStorage).forEach(key => {
            if (key.startsWith(this.cache.CACHE_KEY_PREFIX)) {
                localStorage.removeItem(key);
            }
        });

        console.log('🗑️ Todo el caché limpiado');
    },

    // Verificar si hay operaciones activas
    hasActiveOperations() {
        return this.activeOperations.size > 0;
    },

    // Obtener operaciones activas
    getActiveOperations() {
        return Array.from(this.activeOperations);
    }
};

