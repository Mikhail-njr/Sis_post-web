            break;
        case 'productos-section':
            await loadProductsSection(contentElement);
            break;
        case 'lotes-section':
            await loadLotesSection(contentElement);
            break;
        case 'proveedores-section':
            await loadProveedoresSection(contentElement);
            break;
        case 'historial-cierres-section':
            await loadHistorialCierresSection(contentElement);
            break;
        case 'metricas-section':
            await loadMetricasSection(contentElement);
            break;
        case 'promociones-section':
            await loadPromocionesSection(contentElement);
            break;
        case 'operations-log-section':
            await loadOperationsLogSection(contentElement);
            break;
        default:
            console.log('Sección no requiere carga diferida:', sectionId);
    }

