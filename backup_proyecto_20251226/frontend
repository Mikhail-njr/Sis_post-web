// Función para procesar y mostrar datos del dashboard
function processDashboardData(dashboardData) {
    // Mostrar productos más vendidos
    const topProductsTable = document.getElementById('top-products-table');
    if (topProductsTable) {
        const tbody = topProductsTable.querySelector('tbody');
        tbody.innerHTML = '';

        if (dashboardData.topProducts && dashboardData.topProducts.length > 0) {
            dashboardData.topProducts.forEach((product, index) => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${index + 1}</td>
                    <td>${product.nombre}</td>
                    <td>${product.codigo}</td>
                    <td>${product.total_vendido}</td>
                `;
                tbody.appendChild(row);
            });
        }
    }

    // Mostrar historial de cierres
    const historialTable = document.getElementById('historial-cierres-table');
    if (historialTable) {
        const tbody = historialTable.querySelector('tbody');
        tbody.innerHTML = '';

        if (dashboardData.cierres && dashboardData.cierres.length > 0) {
            // Poblar el dropdown de cierres
            const cierreSelect = document.getElementById('cierre-select');
            if (cierreSelect) {
                // Solo poblar si no tiene opciones ya (evitar sobreescribir)
                if (cierreSelect.options.length <= 1) { // Solo la opción por defecto
                    cierreSelect.innerHTML = '<option value="">Seleccionar cierre...</option>';
                    dashboardData.cierres.forEach((cierre, index) => {
                        const option = document.createElement('option');
                        option.value = index; // Usar índice como valor
                        option.textContent = `${DateUtils.formatForDisplay(cierre.fecha)} - ${formatCurrency(cierre.total_esperado)} (${cierre.cantidad_ventas} ventas)`;
                        option.dataset.cierreData = JSON.stringify(cierre); // Guardar datos del cierre
                        cierreSelect.appendChild(option);
                    });
                }
            }

            dashboardData.cierres.forEach((cierre, index) => {
                const row = document.createElement('tr');
                row.dataset.cierreIndex = index; // Agregar índice para referencia
                row.innerHTML = `
                    <td>${DateUtils.formatForDisplay(cierre.fecha)}</td>
                    <td>${formatCurrency(cierre.dinero_inicial)}</td>
                    <td>${formatCurrency(cierre.total_ventas)}</td>
                    <td>${formatCurrency(cierre.total_esperado)}</td>
                    <td>${formatCurrency(cierre.diferencia)}</td>
                    <td>${cierre.cantidad_ventas}</td>
                `;
                tbody.appendChild(row);
            });
            historialTable.style.display = 'table';

            // Configurar eventos para el dropdown si no están configurados
            if (cierreSelect && !cierreSelect.hasAttribute('data-events-setup')) {
                setupCierreDropdownEvents();
                cierreSelect.setAttribute('data-events-setup', 'true');
            }
        }
        document.querySelector('#historial-cierres-section .loading').style.display = 'none';
    }

    // Mostrar alertas de vencimiento usando datos del dashboard
    if (dashboardData.expiringSoon || dashboardData.expired) {
        displayExpirationAlerts(dashboardData.expiringSoon || [], dashboardData.expired || []);
    }

    // Mostrar productos con stock bajo usando datos del dashboard
    if (dashboardData.products) {
        const lowStockProducts = dashboardData.products.filter(p => p.stock <= 5 && p.stock > 0);
        if (lowStockProducts.length > 0) {
            displayLowStockAlerts(lowStockProducts);
        }
    }

    // Almacenar datos globales para otras funciones que puedan necesitarlos
    window.dashboardData = dashboardData;
}

