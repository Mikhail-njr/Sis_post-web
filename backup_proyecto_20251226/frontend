// Función para confirmar llegada y crear lotes con flujo atómico mejorado
async function confirmDelivery() {
    if (!currentDeliveryOrder) {
        showAlert('No hay pedido seleccionado', 'error');
        return;
    }

    try {
        // Recopilar datos de items confirmados
        const items = [];
        const deliveryItems = document.querySelectorAll('.delivery-item');
        let hasErrors = false;

        deliveryItems.forEach(itemDiv => {
            const productId = itemDiv.dataset.productId;
            const receivedQtyInput = itemDiv.querySelector('.received-quantity');
            const expiryDateInput = itemDiv.querySelector('.expiry-date');
            const costInput = itemDiv.querySelector('.cost-unitario');

            const receivedQty = parseInt(receivedQtyInput.value) || 0;
            const expiryDate = expiryDateInput.value;
            const cost = parseFloat(costInput.value) || 0;

            // Limpiar estilos de error previos
            receivedQtyInput.style.borderColor = '#ddd';
            expiryDateInput.style.borderColor = '#ddd';
            costInput.style.borderColor = '#ddd';

            // Validaciones
            let itemErrors = [];

            if (receivedQty < 0) {
                itemErrors.push('La cantidad no puede ser negativa');
                receivedQtyInput.style.borderColor = '#dc3545';
            }

            if (receivedQty > 0) {
                if (!expiryDate) {
                    itemErrors.push('La fecha de vencimiento es requerida');
                    expiryDateInput.style.borderColor = '#dc3545';
                } else {
                    const today = DateUtils.getCurrentSystemDate();
                    today.setHours(0, 0, 0, 0);
                    const expiry = new Date(expiryDate);
                    if (isNaN(expiry.getTime()) || expiry < today) {
                        itemErrors.push('La fecha de vencimiento debe ser futura');
                        expiryDateInput.style.borderColor = '#dc3545';
                    }
                }

                if (cost < 0) {
                    itemErrors.push('El costo unitario no puede ser negativo');
                    costInput.style.borderColor = '#dc3545';
                }
            }

            if (itemErrors.length > 0) {
                hasErrors = true;
                const productName = itemDiv.querySelector('strong').textContent;
                showAlert(`Errores en ${productName}: ${itemErrors.join(', ')}`, 'error');
            } else if (receivedQty > 0) {
                items.push({
                    producto_id: productId,
                    cantidad_recibida: receivedQty,
                    fecha_vencimiento: expiryDate,
                    costo_unitario: cost
                });
            }
        });

        // Recopilar datos de items extra
        const extraItems = [];
        const extraItemDivs = document.querySelectorAll('.extra-item');

        extraItemDivs.forEach(itemDiv => {
            const select = itemDiv.querySelector('.extra-product-select');
            const quantityInput = itemDiv.querySelector('.extra-quantity');
            const expiryDateInput = itemDiv.querySelector('.extra-expiry');
            const costInput = itemDiv.querySelector('.extra-cost');

            const productId = select.value;
            const quantity = parseInt(quantityInput.value) || 0;
            const expiryDate = expiryDateInput.value;
            const cost = parseFloat(costInput.value) || 0;

            // Limpiar estilos de error previos
            select.style.borderColor = '#28a745';
            quantityInput.style.borderColor = '#28a745';
            expiryDateInput.style.borderColor = '#28a745';
            costInput.style.borderColor = '#28a745';

            // Validaciones para items extra
            let itemErrors = [];

            if (!productId) {
                itemErrors.push('Debe seleccionar un producto');
                select.style.borderColor = '#dc3545';
            }

            if (quantity <= 0) {
                itemErrors.push('La cantidad debe ser mayor a 0');
                quantityInput.style.borderColor = '#dc3545';
            }

            if (!expiryDate) {
                itemErrors.push('La fecha de vencimiento es requerida');
                expiryDateInput.style.borderColor = '#dc3545';
            } else {
                const today = DateUtils.getCurrentSystemDate();
                today.setHours(0, 0, 0, 0);
                const expiry = new Date(expiryDate);
                if (isNaN(expiry.getTime()) || expiry < today) {
                    itemErrors.push('La fecha de vencimiento debe ser futura');
                    expiryDateInput.style.borderColor = '#dc3545';
                }
            }

            if (cost < 0) {
                itemErrors.push('El costo unitario no puede ser negativo');
                costInput.style.borderColor = '#dc3545';
            }

            if (itemErrors.length > 0) {
                hasErrors = true;
                showAlert(`Errores en item extra: ${itemErrors.join(', ')}`, 'error');
            } else if (productId && quantity > 0) {
                const selectedOption = select.options[select.selectedIndex];
                const productName = selectedOption ? selectedOption.textContent : 'Producto desconocido';

                extraItems.push({
                    producto_id: productId,
                    producto_nombre: productName,
                    cantidad: quantity,
                    fecha_vencimiento: expiryDate,
                    costo_unitario: cost
                });
            }
        });

        // Si hay errores, detener el proceso
        if (hasErrors) {
            return;
        }

        // Validar que hay al menos un item
        if (items.length === 0 && extraItems.length === 0) {
            showAlert('Debe confirmar al menos un item recibido', 'error');
            return;
        }

        // Mostrar confirmación final
        const totalItems = items.length + extraItems.length;
        const confirmMessage = `¿Confirmar recepción de ${totalItems} item(s)?\n\n` +
                              `Items del pedido: ${items.length}\n` +
                              `Items extra: ${extraItems.length}\n\n` +
                              `Se crearán automáticamente los lotes correspondientes y el pedido se marcará como entregado.`;

        if (!confirm(confirmMessage)) {
            return;
        }

        // Obtener fecha de entrega real del input - ahora es obligatoria
        let actualDeliveryDateInput = document.getElementById('actualDeliveryDate').value;

        // Si no hay fecha seleccionada, sumar un día a la fecha actual del sistema
        if (!actualDeliveryDateInput) {
            const tomorrow = new Date(DateUtils.getCurrentSystemDate());
            tomorrow.setDate(tomorrow.getDate() + 1);
            actualDeliveryDateInput = tomorrow.toISOString().split('T')[0];
            document.getElementById('actualDeliveryDate').value = actualDeliveryDateInput;
        }

        const actualDeliveryDate = actualDeliveryDateInput;

        // Validar que la fecha no sea futura
        const inputDate = new Date(actualDeliveryDate + 'T00:00:00');
        const today = DateUtils.getCurrentSystemDate();
        today.setHours(0, 0, 0, 0);

        if (inputDate > today) {
            showAlert('❌ La fecha de entrega no puede ser futura', 'error');
            return;
        }

        // Preparar datos para envío
        const requestData = { items, extraItems, fecha_entrega_real: actualDeliveryDate };

        // Deshabilitar modal durante la operación para prevenir cierres accidentales
        const modal = document.getElementById('confirmDeliveryModal');
        const originalPointerEvents = modal.style.pointerEvents;
        modal.style.pointerEvents = 'none';

        // Mostrar indicador de carga
        const confirmButton = document.querySelector('#confirmDeliveryModal .button-group button:first-child');
        const originalButtonText = confirmButton ? confirmButton.textContent : '';
        if (confirmButton) {
            confirmButton.disabled = true;
            confirmButton.textContent = '⏳ Procesando...';
        }

        try {
            // PASO 1: Crear/actualizar lotes (sin cambiar estado aún)
            console.log('📦 Paso 1: Creando/actualizando lotes...');
            const deliveryResponse = await window.ApiClient.apiRequest(`/supplier-orders/${currentDeliveryOrder.id}/confirm-delivery`, {
                method: 'POST',
                body: JSON.stringify(requestData)
            });

            // PASO 2: Cambiar estado a "entregado" SOLO si el paso anterior funcionó
            console.log('📋 Paso 2: Actualizando estado del pedido...');
            await window.ApiClient.apiRequest(`/supplier-orders/${currentDeliveryOrder.id}/status`, {
                method: 'PUT',
                body: JSON.stringify({ estado: 'entregado' })
            });

            // PASO 3: Actualizar UI solo después de que AMBOS pasos funcionaron
            console.log('✅ Ambos pasos completados exitosamente');
            showAlert(`✅ ${deliveryResponse.message}`, 'success');

            // Invalidar caché antes de actualizar la UI para asegurar datos frescos
            DashboardCache.invalidate();

            // Actualizar inmediatamente el selector y badge del pedido en la UI
            updateOrderRowInUI(currentDeliveryOrder.id, actualDeliveryDate);

            // Recargar productos para actualizar stock
            if (typeof loadProducts === 'function') {
                loadProducts();
            }

            // Recargar pedidos de proveedores para actualizar la tabla
            if (typeof fetchSupplierOrders === 'function') {
                fetchSupplierOrders(true); // Forzar refresh de datos
            }

            // Cerrar modal después de completar todas las operaciones
            closeConfirmDeliveryModalSuccess();

        } catch (error) {
            console.error('❌ Error en el proceso de confirmación:', error);

            // Manejar errores específicos
            if (error.message && error.message.includes('ya fue marcado como entregado')) {
                showAlert('❌ Este pedido ya fue confirmado como entregado anteriormente.', 'error');
            } else {
                showAlert('❌ Error al confirmar la entrega: ' + error.message, 'error');
            }

            // IMPORTANTE: Si el primer paso funcionó pero el segundo falló,
            // el pedido queda en estado inconsistente. En una implementación ideal,
            // debería haber un mecanismo de rollback o el servidor debería manejar
            // ambas operaciones en una transacción.

        } finally {
            // Restaurar estado del modal
            modal.style.pointerEvents = originalPointerEvents;
            if (confirmButton) {
                confirmButton.disabled = false;
                confirmButton.textContent = originalButtonText;
            }
        }

    } catch (error) {
        console.error('Error confirmando entrega:', error);
        showAlert('Error al confirmar la entrega: ' + error.message, 'error');
    }
}

