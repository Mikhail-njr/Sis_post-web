// Utilidad centralizada para manejo de fechas con zona horaria del sistema (Argentina UTC-3)
const DateUtils = {
    // Zona horaria del sistema
    SYSTEM_TIMEZONE: 'America/Buenos_Aires',
    SYSTEM_TIMEZONE_OFFSET: -3, // UTC-3

    // Obtener fecha actual del sistema
    getCurrentSystemDate() {
        const now = new Date();
        return new Date(now.getTime() + (this.SYSTEM_TIMEZONE_OFFSET * 60 * 60 * 1000));
    },

    // Formatear fecha para display (con zona horaria del sistema)
    formatForDisplay(dateString, options = {}) {
        try {
            const date = new Date(dateString);
            if (isNaN(date.getTime())) return dateString;

            // Ajustar por zona horaria del sistema para display consistente
            const systemDate = new Date(date.getTime() + (this.SYSTEM_TIMEZONE_OFFSET * 60 * 60 * 1000));

            // Si se especifica dateStyle, usar solo eso; de lo contrario, usar opciones detalladas
            if (options.dateStyle) {
                return systemDate.toLocaleString('es-AR', {
                    dateStyle: options.dateStyle,
                    timeStyle: options.timeStyle || 'short'
                });
            } else {
                return systemDate.toLocaleString('es-AR', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit',
                    hour12: false,
                    ...options
                });
            }
        } catch (error) {
            console.warn('Error formatting date for display:', error);
            return dateString;
        }
    },

    // Formatear fecha para envío al backend (UTC)
    formatForBackend(dateString) {
        try {
            const date = new Date(dateString);
            if (isNaN(date.getTime())) return dateString;

            // Convertir a UTC para almacenamiento consistente
            return date.toISOString();
        } catch (error) {
            console.warn('Error formatting date for backend:', error);
            return dateString;
        }
    },

    // Calcular días de diferencia considerando zona horaria del sistema
    calculateDaysDifference(dateString) {
        try {
            const targetDate = new Date(dateString);
            const today = this.getCurrentSystemDate();

            // Resetear horas para comparación de días
            const target = new Date(targetDate);
            target.setHours(0, 0, 0, 0);
            const current = new Date(today);
            current.setHours(0, 0, 0, 0);

            const diffTime = target.getTime() - current.getTime();
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            return diffDays;
        } catch (error) {
            console.warn('Error calculating days difference:', error);
            return 0;
        }
    },

    // Validar que una fecha sea futura considerando zona horaria del sistema
    isFutureDate(dateString) {
        try {
            const inputDate = new Date(dateString + 'T00:00:00');
            const today = this.getCurrentSystemDate();
            today.setHours(0, 0, 0, 0);

            return inputDate >= today;
        } catch (error) {
            console.warn('Error validating future date:', error);
            return false;
        }
    }
};

