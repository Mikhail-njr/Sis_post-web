        function displayResults(products, append = false) {
            const resultsGrid = document.getElementById('resultsGrid');

            // Validar que products sea un array válido
            if (!products || !Array.isArray(products)) {
                if (!append) {
                    resultsGrid.innerHTML = '<div class="alert error">❌ No se encontraron productos</div>';
                }
                return;
            }

            // Filtrar productos en promoción si el filtro está activo
            if (promotionFilterActive) {
                products = products.filter(p => p.descuento_porcentaje && p.descuento_porcentaje > 0);
            }

            if (!append && products.length === 0) {
                resultsGrid.innerHTML = '<div class="alert error">❌ No se encontraron productos</div>';
                return;
            }

            if (!append) {
                // Limpiar grid si no es append
                resultsGrid.innerHTML = '';
            }

            if (products.length === 0 && append) {
                return; // No hay productos nuevos para append
            }

            // Use DocumentFragment for better performance
            const fragment = document.createDocumentFragment();

            products.forEach(product => {
                // Cachear producto para evitar GET adicional
                productsCache[product.id] = product;

                const hasDiscount = product.descuento_porcentaje && product.descuento_porcentaje > 0;
                const originalPrice = parseFloat(product.precio);
                const discountedPrice = parseFloat(product.precio_con_descuento || product.precio);

                const card = document.createElement('div');
                card.className = `product-card ${hasDiscount ? 'promotion' : ''} ${product.estado_vencimiento === 'vencido' ? 'expired' : product.estado_vencimiento === 'proximo_vencer' ? 'expiring-soon' : ''}`;
                card.onclick = () => selectProduct(product.id);

                card.innerHTML = `
                    <div style="flex-grow: 1;">
                        <span class="product-code">${product.codigo}</span>
                        <div class="product-name">${product.nombre}</div>
                        ${hasDiscount ? `<div style="color: #e74c3c; font-weight: bold; font-size: 0.9em;">🎉 ${product.descuento_porcentaje}% OFF</div>` : ''}
                    </div>
                    <div class="product-info">
                        <div class="price">
                            <span style="font-size: 0.8em;">💰</span>
                            ${hasDiscount ? `<span style="text-decoration: line-through; color: #7f8c8d; font-size: 0.9em;">${formatCurrency(originalPrice)}</span> ` : ''}
                            ${formatCurrency(discountedPrice)}
                        </div>
                        <div class="stock" style="${product.stock == 0 ? 'color: red;' : ''}">Stock: ${product.stock}</div>
                        <div class="category">${product.categoria}</div>
                        ${product.estado_vencimiento === 'vencido' ? '<div style="color: #dc3545; font-weight: bold; font-size: 0.8em;">⚠️ VENCIDO</div>' :
                          product.estado_vencimiento === 'proximo_vencer' ? '<div style="color: #ffc107; font-weight: bold; font-size: 0.8em;">⏰ Próximo a vencer</div>' :
                          '<div style="color: #28a745; font-size: 0.8em;">✅ Vigente</div>'}
                    </div>
                `;

                fragment.appendChild(card);
            });

            resultsGrid.appendChild(fragment);
        }

        async function selectProduct(productId) {
            try {
                let product;

                // Buscar en cache primero
                if (productsCache[productId]) {
                    product = productsCache[productId];
                } else {
                    // Si no está en cache, hacer fetch
                    const headers = { 'Content-Type': 'application/json' };
                    if (authCredentials) {
                        headers['Authorization'] = 'Basic ' + btoa(authCredentials.username + ':' + authCredentials.password);
                    }

                    const res = await fetch(`${API_BASE}/products/${productId}`, { headers });
                    if (res.status === 401) {
                        isLoggedIn = false;
                        updateUIBasedOnAuth();
                        showAlert('❌ Autenticación requerida', 'error');
                        return;
                    }
                    if (!res.ok) {
                        throw new Error('Error al obtener producto');
                    }

                    product = await res.json();
                    // Cachear para futuras selecciones
                    productsCache[productId] = product;
                }

                selectedProduct = { ...product };

                // Usar precio con descuento pre-calculado
                const hasDiscount = product.descuento_porcentaje > 0;
                const originalPrice = parseFloat(product.precio);
                const discountedPrice = parseFloat(product.precio_con_descuento || product.precio);

                selectedProduct.precio_original = originalPrice;
                selectedProduct.precio = discountedPrice;
                selectedProduct.tiene_descuento = hasDiscount;
                selectedProduct.descuento_porcentaje = hasDiscount ? product.descuento_porcentaje : 0;

                let priceDisplay = `Precio: ${formatCurrency(discountedPrice)}`;
                if (hasDiscount) {
                    priceDisplay = `Precio: <span style="text-decoration: line-through; color: #7f8c8d;">${formatCurrency(originalPrice)}</span> ${formatCurrency(discountedPrice)} (${product.descuento_porcentaje}% OFF)`;
                }

                let loteInfo = '';
                if (selectedProduct.fecha_vencimiento) {
                    const fechaVencimiento = new Date(selectedProduct.fecha_vencimiento).toLocaleDateString('es-AR');
                    const estadoVencimiento = selectedProduct.estado_vencimiento === 'vencido' ? '⚠️ VENCIDO' :
                                              selectedProduct.estado_vencimiento === 'proximo_vencer' ? `⏰ Próximo a vencer (${selectedProduct.dias_para_vencer} días)` :
                                              '✅ Vigente';
                    loteInfo = `<br>Fecha de vencimiento: ${fechaVencimiento} (${estadoVencimiento})`;
                    if (selectedProduct.costo_adquisicion) {
                        loteInfo += `<br>Costo de adquisición: ${formatCurrency(selectedProduct.costo_adquisicion)}`;
                    }
                }

                document.getElementById('modalProductInfo').innerHTML = `
                    <div style="font-size:1.5em; font-weight:bold; margin-bottom:8px;">${selectedProduct.codigo} - ${selectedProduct.nombre}</div>
                    ${priceDisplay}<br>
                    Stock disponible: <span style="${selectedProduct.stock == 0 ? 'color: red;' : ''}">${selectedProduct.stock}</span><br>
                    Categoría: ${selectedProduct.categoria}
                    ${loteInfo.replace('(undefined días)', '')}
                `;
                document.getElementById('modalQuantityInput').value = 1;
                document.getElementById('modalQuantityInput').max = selectedProduct.stock;

                document.getElementById('productModal').style.display = 'flex';
            } catch (error) {
                showAlert('❌ Error al seleccionar producto', 'error');
            }
        }

        // Función para buscar producto por código de barras y abrir modal (para WebSocket)
        async function searchProductByBarcodeAndOpenModal(barcode) {
            try {
                const headers = { 'Content-Type': 'application/json' };
                if (authCredentials) {
                    headers['Authorization'] = 'Basic ' + btoa(authCredentials.username + ':' + authCredentials.password);
                }

                const response = await fetch(`${API_BASE}/products/search-by-barcode/${barcode}`, { headers });

                if (response.status === 404) {
                    showAlert(`❌ No se encontró producto con código: ${barcode}`, 'error');
                    return;
                }

                if (!response.ok) {
                    throw new Error(`Error ${response.status}: ${response.statusText}`);
                }

                const data = await response.json();

                if (data.found && data.product) {
                    // Producto encontrado, abrir modal
                    await selectProduct(data.product.id);
                    showAlert(`✅ Producto encontrado: ${data.product.nombre}`, 'success');
                } else {
                    showAlert(`❌ Producto no encontrado con código: ${barcode}`, 'error');
                }

            } catch (error) {
                console.error('Error buscando producto por código de barras:', error);
                showAlert('❌ Error al buscar producto por código de barras', 'error');
            }
        }

        // Función para buscar producto por código de barras y agregar directamente al carrito (para WebSocket y USB)
        async function searchProductByBarcodeAndAddToCart(barcode, source = 'unknown') {
            try {
                console.log(`🔍 Buscando producto con código ${source}: ${barcode}`);

                const headers = { 'Content-Type': 'application/json' };
                if (authCredentials) {
                    headers['Authorization'] = 'Basic ' + btoa(authCredentials.username + ':' + authCredentials.password);
                }

                const response = await fetch(`${API_BASE}/products/search-by-barcode/${barcode}`, { headers });

                if (response.status === 404) {
                    showAlert(`❌ No se encontró producto con código: ${barcode}`, 'error');
                    if (source === 'USB') {
                        updateUSBScannerStatus('Código no encontrado', 'error');
                        setTimeout(() => updateUSBScannerStatus('Listo', 'active'), 3000);
                    }
                    return;
                }

                if (!response.ok) {
                    throw new Error(`Error ${response.status}: ${response.statusText}`);
                }

                const data = await response.json();

                if (data.found && data.product) {
                    const product = data.product;
                    const lote = data.lote;

                    // Verificar stock disponible
                    if (lote.cantidad_actual <= 0) {
                        showAlert('❌ El lote escaneado no tiene stock disponible', 'error');
                        if (source === 'USB') {
                            updateUSBScannerStatus('Sin stock', 'error');
                            setTimeout(() => updateUSBScannerStatus('Listo', 'active'), 3000);
                        }
                        return;
                    }

                    // Agregar al carrito directamente (cantidad 1 por defecto)
                    const existing = cart.find(item => item.id === product.id);
                    if (existing) {
                        if (existing.cantidad >= lote.cantidad_actual) {
                            showAlert('❌ Stock insuficiente en el lote', 'error');
                            if (source === 'USB') {
                                updateUSBScannerStatus('Stock insuficiente', 'error');
                                setTimeout(() => updateUSBScannerStatus('Listo', 'active'), 3000);
                            }
                            return;
                        }
                        existing.cantidad += 1;
                    } else {
                        cart.push({
                            ...product,
                            cantidad: 1,
                            lote_id: lote.id,
                            lote_info: {
                                numero_lote: lote.numero_lote,
                                fecha_vencimiento: lote.fecha_vencimiento,
                                cantidad_actual: lote.cantidad_actual
                            }
                        });
                    }

                    updateCart();

                    // Actualizar estado del escáner USB si es fuente USB
                    if (source === 'USB') {
                        updateUSBScannerStatus('Producto agregado', 'active');
                        setTimeout(() => updateUSBScannerStatus('Listo', 'active'), 2000);
                    }

                    const sourceText = source === 'USB' ? ' (USB)' : source === 'mobile' ? ' (Móvil)' : '';
                    showAlert(`✅ ${product.nombre} agregado al carrito${sourceText}`, 'success');
                } else {
                    showAlert(`❌ Producto no encontrado con código: ${barcode}`, 'error');
                    if (source === 'USB') {
                        updateUSBScannerStatus('Código no encontrado', 'error');
                        setTimeout(() => updateUSBScannerStatus('Listo', 'active'), 3000);
                    }
                }

            } catch (error) {
                console.error(`Error buscando producto por código de barras (${source}):`, error);
                showAlert('❌ Error al buscar producto por código de barras', 'error');
                if (source === 'USB') {
                    updateUSBScannerStatus('Error', 'error');
                    setTimeout(() => updateUSBScannerStatus('Listo', 'active'), 3000);
                }
            }
        }

        function changeModalQuantity(delta) {
            const input = document.getElementById('modalQuantityInput');
            let value = parseInt(input.value, 10) || 1;
            let max = parseInt(input.max, 10) || 1;
            value += delta;
            if (value < 1) value = 1;
            if (value > max) value = max;
            input.value = value;
        }

        function closeProductModal() {
            document.getElementById('productModal').style.display = 'none';
        }

        function addToCartFromModal() {
            const quantity = parseInt(document.getElementById('modalQuantityInput').value, 10);
            if (!selectedProduct || quantity < 1 || quantity > selectedProduct.stock) {
                showAlert('❌ Cantidad inválida', 'error');
                return;
            }

            const existing = cart.find(item => item.id === selectedProduct.id);
            if (existing) {
                if (existing.cantidad + quantity > selectedProduct.stock) {
                    showAlert('❌ Stock insuficiente', 'error');
                    return;
                }
                existing.cantidad += quantity;
            } else {
                cart.push({ ...selectedProduct, cantidad: quantity });
            }
            
            updateCart();
            closeProductModal();
            showAlert('✅ Producto agregado al carrito', 'success');
        }

        function updateCart() {
            // Sincronizar window.cart con cart global
            if (typeof window !== 'undefined') {
                window.cart = cart;
            }

            const cartItems = document.getElementById('cartItems');
            const totalElement = document.getElementById('cartTotal');

            // Limpiar completamente el contenedor primero
            cartItems.innerHTML = '';

            if (cart.length === 0) {
                cartItems.innerHTML = `<div style="text-align: center; color: #7f8c8d; padding: 20px;">
                    El carrito está vacío
                </div>`;
                totalElement.textContent = `Total: $0.00`;
                updatePaymentSummary();
                return;
            }

            // Crear fragmento para todos los elementos
            const fragment = document.createDocumentFragment();

            cart.forEach(item => {
                const precioUnitario = parseFloat(item.precio_original || item.precio);
                const precioConDescuento = parseFloat(item.precio);
                const precioAUtilizar = precioConDescuento; // Siempre usar precio con descuento
                const subtotal = precioAUtilizar * item.cantidad;
                const ahorroTotal = item.tiene_descuento ? (precioUnitario - precioConDescuento) * item.cantidad : 0;

                let priceDisplay = `${item.nombre} x${item.cantidad}`;
                if (item.tiene_descuento) {
                    priceDisplay += ` 🎉 ${item.descuento_porcentaje}% OFF`;
                }

                const cartItem = document.createElement('div');
                cartItem.className = 'cart-item';
                if (item.tiene_descuento) {
                    cartItem.style.borderLeft = '4px solid #e74c3c';
                    cartItem.style.background = 'linear-gradient(90deg, #fff5f5 0%, #ffffff 100%)';
                }

                cartItem.innerHTML = `
                    <div style="flex: 1;">
                        <div style="font-weight: bold; ${item.tiene_descuento ? 'color: #e74c3c;' : ''}">${priceDisplay}</div>
                        ${item.tiene_descuento ? `
                            <div style="font-size: 0.9em; color: #27ae60; margin-top: 4px; font-weight: 500;">
                                <span style="text-decoration: line-through; color: #7f8c8d; font-size: 0.9em;">${formatCurrency(precioUnitario)}</span>
                                → <strong style="color: #e74c3c;">${formatCurrency(precioConDescuento)}</strong> c/u
                                ${ahorroTotal > 0 ? `<br><em style="color: #27ae60;">💰 Ahorro: ${formatCurrency(ahorroTotal)}</em>` : ''}
                            </div>
                        ` : `
                            <div style="font-size: 0.8em; color: #7f8c8d;">
                                Precio: ${formatCurrency(precioUnitario)} c/u
                            </div>
                        `}
                    </div>
                    <div style="text-align: right;">
                        <div style="font-weight: bold; font-size: 1.1em; ${item.tiene_descuento ? 'color: #e74c3c;' : ''}">${formatCurrency(subtotal)}</div>
                        <button class="decrease-item-btn" data-product-id="${item.id}" style="font-size: 14px; padding: 2px 6px; margin-top: 4px;">➖</button>
                        <button class="remove-item-btn" data-product-id="${item.id}" style="font-size: 14px; padding: 2px 6px; margin-top: 4px;">❌</button>
                    </div>
                `;

                fragment.appendChild(cartItem);
            });

            cartItems.appendChild(fragment);

            const total = calcularTotal();
            totalElement.textContent = `Total: ${formatCurrency(total)}`;
            updatePaymentSummary();
        }

        function removeFromCart(productId) {
            const initialCartSize = cart.length;
            cart = cart.filter(item => String(item.id) !== String(productId));

            if (cart.length < initialCartSize) {
                updateCart();
                showAlert('🗑️ Producto removido del carrito', 'success');
            } else {
                console.log(`Error: No se encontró el producto con ID ${productId} en el carrito.`);
                showAlert('❌ Error al remover el producto', 'error');
            }
        }

        function decreaseFromCart(productId) {
            const item = cart.find(item => String(item.id) === String(productId));
            if (item) {
                item.cantidad -= 1;
                if (item.cantidad <= 0) {
                    // Si la cantidad llega a 0, eliminar el producto del carrito
                    cart = cart.filter(item => String(item.id) !== String(productId));
                    showAlert('🗑️ Producto removido del carrito', 'success');
                } else {
                    showAlert('➖ Cantidad reducida', 'success');
                }
                updateCart();
            } else {
                console.log(`Error: No se encontró el producto con ID ${productId} en el carrito.`);
                showAlert('❌ Error al reducir la cantidad', 'error');
            }
        }

        function togglePaymentMethod(method) {
            // Buscar el div del método de pago por su data-method o contenido de texto
            const methodDivs = document.querySelectorAll('.payment-method');
            let methodDiv = null;

            // Primero buscar por data-method (para cuenta corriente)
            if (method === 'cuentaCorriente') {
                methodDiv = document.querySelector('.payment-method[data-method="cuentaCorriente"]');
            }

            // Si no se encuentra por data-method, buscar por texto
            if (!methodDiv) {
                const searchText = method;
                for (let div of methodDivs) {
                    const textContent = div.textContent.toLowerCase();
                    if (textContent.includes(searchText.toLowerCase())) {
                        methodDiv = div;
                        break;
                    }
                }
            }

            // Si no se encuentra por texto, intentar con un selector más genérico
            if (!methodDiv) {
                methodDiv = document.querySelector(`.payment-method:nth-child(${getPaymentMethodIndex(method)})`);
            }

            // Si aún no se encuentra, usar un ID específico para efectivo
            if (!methodDiv && method === 'efectivo') {
                methodDiv = document.getElementById('efectivo-payment-method');
            }

            // Para cuenta corriente, no hay input ni maxBtn - solo mostrar/ocultar info del cliente
            if (method === 'cuentaCorriente') {
                if (methodDiv.classList.contains('selected')) {
                    methodDiv.classList.remove('selected');
                    const cuentaCorrienteInfo = document.getElementById('cuentaCorriente-info');
                    if (cuentaCorrienteInfo) {
                        cuentaCorrienteInfo.style.display = 'none';
                    }
                    delete selectedPaymentMethods[method];
                } else {
                    methodDiv.classList.add('selected');
                    const cuentaCorrienteInfo = document.getElementById('cuentaCorriente-info');
                    if (cuentaCorrienteInfo) {
                        cuentaCorrienteInfo.style.display = 'block';
                    }
                    selectedPaymentMethods[method] = calcularTotal(); // El monto es el total de la venta
                }
                updatePaymentSummary();
                return;
            }

            // Para otros métodos, buscar input y maxBtn
            const input = document.getElementById(`${method}-amount`);
            const maxBtn = document.getElementById(`${method}-max`);

            if (!methodDiv || !input || !maxBtn) {
                console.error(`No se encontró el elemento para el método: ${method}`);
                console.error('methodDiv:', methodDiv);
                console.error('input:', input);
                console.error('maxBtn:', maxBtn);
                return;
            }

            if (methodDiv.classList.contains('selected')) {
                methodDiv.classList.remove('selected');
                input.style.display = 'none';
                maxBtn.style.display = 'none';
                input.value = '';
                delete selectedPaymentMethods[method];
            } else {
                methodDiv.classList.add('selected');
                input.style.display = 'block';
                maxBtn.style.display = 'inline-block';
                selectedPaymentMethods[method] = 0;
                setTimeout(() => input.focus(), 100);
            }
            updatePaymentSummary();
        }
        
        function getPaymentMethodIndex(method) {
            const methods = ['efectivo', 'transferencia', 'debito', 'credito', 'cuentaCorriente'];
            const index = methods.indexOf(method) + 1;
            return index > 0 ? index : 1;
        }

        function updatePaymentSummary() {
            const totalToPay = calcularTotal();
            document.getElementById('totalToPay').textContent = formatCurrency(totalToPay);

            // Calcular total pagado
            let totalPaid = 0;
            let hasCuentaCorriente = false;

            for (const method in selectedPaymentMethods) {
                if (method === 'cuentaCorriente') {
                    // Para cuenta corriente, el monto pagado es el total de la venta
                    hasCuentaCorriente = true;
                    totalPaid = totalToPay;
                    selectedPaymentMethods[method] = totalToPay;
                } else {
                    const amount = parseFloat(document.getElementById(`${method}-amount`).value) || 0;
                    selectedPaymentMethods[method] = amount;
                    totalPaid += amount;
                }
            }

            // Si solo hay cuenta corriente seleccionada, mostrar el total como pagado
            if (hasCuentaCorriente && Object.keys(selectedPaymentMethods).length === 1) {
                totalPaid = totalToPay;
            }

            document.getElementById('totalPaid').textContent = formatCurrency(totalPaid);

            const change = totalToPay > 0 ? totalPaid - totalToPay : 0;
            document.getElementById('change').textContent = formatCurrency(Math.max(0, change));
        }

        function setMaxAmount(method) {
            const totalToPay = calcularTotal();
            let currentPaid = 0;
            for (const m in selectedPaymentMethods) {
                if (m !== method) currentPaid += selectedPaymentMethods[m];
            }
            const remaining = totalToPay - currentPaid;
            const input = document.getElementById(`${method}-amount`);
            input.value = remaining > 0 ? remaining.toFixed(2) : '0.00';
            updatePaymentSummary();
        }

        function simulatePayment() {
            if (cart.length === 0) {
                showAlert('❌ El carrito está vacío', 'error');
                return;
            }

            let totalPaid = 0;
            const paymentDetails = [];
            for (const method in selectedPaymentMethods) {
                const amount = selectedPaymentMethods[method];
                if (amount > 0) {
                    totalPaid += amount;
                    paymentDetails.push({ metodo: method, monto: amount });
                }
            }

            // Calcular total
            const total = calcularTotal();

            // Generar factura simulada detallada
            const invoiceNumber = `SIM-${Date.now()}`;
