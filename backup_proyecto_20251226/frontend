        // Función para inicializar detección de escáner USB
        function initUSBScannerDetection() {
            // Crear un campo invisible para capturar entrada del escáner
            const usbInput = document.createElement('input');
            usbInput.id = 'usb-scanner-input';
            usbInput.type = 'text';
            usbInput.style.position = 'absolute';
            usbInput.style.left = '-9999px';
            usbInput.style.top = '-9999px';
            usbInput.style.opacity = '0';
            usbInput.style.pointerEvents = 'none';
            usbInput.style.zIndex = '-1';
            document.body.appendChild(usbInput);

            // Enfocar el campo invisible inicialmente
            usbInput.focus();

            // Listener para capturar entrada del escáner
            usbInput.addEventListener('keydown', function(e) {
                const currentTime = Date.now();
                const timeDiff = currentTime - lastKeyTime;
                lastKeyTime = currentTime;

                // Si hay una pausa larga (>500ms), limpiar buffer (entrada manual)
                if (timeDiff > 500) {
                    usbScannerBuffer = '';
                    clearTimeout(usbScannerTimeout);
                }

                // Si es Enter y tenemos un buffer, procesar como escáner
                if (e.key === 'Enter' && usbScannerBuffer.length > 0) {
                    e.preventDefault();
                    processUSBScannerCode(usbScannerBuffer.trim());
                    usbScannerBuffer = '';
                    clearTimeout(usbScannerTimeout);
                    return;
                }

                // Si es un carácter válido, agregarlo al buffer
                if (e.key.length === 1 && /^[0-9]$/.test(e.key)) {
                    usbScannerBuffer += e.key;

                    // Configurar timeout para procesar si no viene más entrada
                    clearTimeout(usbScannerTimeout);
                    usbScannerTimeout = setTimeout(() => {
                        if (usbScannerBuffer.length >= 8) { // Mínimo EAN-8
                            processUSBScannerCode(usbScannerBuffer);
                        }
                        usbScannerBuffer = '';
                    }, USB_SCANNER_TIMEOUT);
                }
            });

            // Mantener el foco en el campo USB cuando se pierde
            document.addEventListener('click', function() {
                // Solo reenfocar si no estamos en campos de entrada importantes
                const activeElement = document.activeElement;
                const isImportantInput = activeElement && (
                    activeElement.tagName === 'INPUT' ||
                    activeElement.tagName === 'SELECT' ||
                    activeElement.tagName === 'TEXTAREA' ||
                    activeElement.contentEditable === 'true'
                );

                if (!isImportantInput) {
                    setTimeout(() => usbInput.focus(), 100);
                }
            });

            // Agregar indicador visual del escáner USB
            addUSBScannerStatusIndicator();

            console.log('Detección de escáner USB inicializada');
        }

