// Función para crear producto desde el formulario inline
async function createProductInline() {
    const categoria = document.getElementById('newProductCategoria').value.trim();
    const nombre = document.getElementById('newProductNombre').value.trim();
    const precio = parseFloat(document.getElementById('newProductPrecio').value);
    const stock = parseInt(document.getElementById('newProductStock').value) || 0;

    // Validaciones
    if (!categoria || !nombre || isNaN(precio) || precio < 0) {
        showAlert('Por favor complete todos los campos requeridos correctamente', 'error');
        return;
    }

    try {
        // Generar código automáticamente basado en categoría
        const categoryCode = categoria.split(' - ')[0] || categoria.substring(0, 4).toUpperCase();
        const headers = { 'Content-Type': 'application/json' };
        if (authCredentials) {
            headers['Authorization'] = 'Basic ' + btoa(authCredentials.username + ':' + authCredentials.password);
        }

        // Crear el producto
        const response = await fetch(`${API_BASE}/products`, {
            method: 'POST',
            headers: headers,
            body: JSON.stringify({
                categoria: categoria,
                nombre: nombre,
                precio: precio,
                stock: stock,
                descripcion: '',
                generateCode: true, // Indicador para generar código automáticamente
                codigo: '' // Campo requerido pero vacío para que se genere automáticamente
            })
        });

        if (response.status === 401) {
            isLoggedIn = false;
            updateUIBasedOnAuth();
            throw new Error('Autenticación requerida');
        }
        if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.error || 'Error al crear producto');
        }

        const responseData = await response.json();
        const newProduct = responseData.product || responseData;

        // Ocultar formulario
        hideInlineProductCreation();

        // Mostrar mensaje de éxito
        showAlert(`✅ Producto "${newProduct.nombre}" creado exitosamente`, 'success');

        // Actualizar todos los selects de productos en los items del pedido
        updateAllOrderProductSelects();

    } catch (error) {
        console.error('Error creating product inline:', error);
        showAlert('❌ Error al crear producto: ' + error.message, 'error');
    }
}

