// Función para cargar sección de ventas (lazy loading)
async function loadSalesSection(contentElement) {
    console.log('Cargando sección de ventas (lazy loading)');
    // Cargar ventas por defecto (últimos 7 días para mostrar más datos)
    const endDate = DateUtils.getCurrentSystemDate();
    const startDate = new Date(endDate);
    startDate.setDate(startDate.getDate() - 7);
    const startDateStr = startDate.toISOString().split('T')[0];
    const endDateStr = endDate.toISOString().split('T')[0];

    // Usar filterSales para cargar con rango de fechas
    const dateInput = document.getElementById('sales-start-date');
    const endDateInput = document.getElementById('sales-end-date');
    if (dateInput) dateInput.value = startDateStr;
    if (endDateInput) endDateInput.value = endDateStr;
    await filterSales();
