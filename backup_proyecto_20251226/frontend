        console.log('⏳ Esperando datos del dashboard para proveedores...');
        await fetchMetrics(true); // Forzar carga del dashboard

        const freshData = DashboardCache.get();
        if (freshData && freshData.suppliers) {
            displaySuppliersTable(freshData.suppliers);
        } else {
