        function validateAndProcessPayment() {
            // Validación rápida antes de procesar
            let hasSelectedMethod = false;
            let hasAmount = false;

            ['efectivo', 'transferencia', 'debito', 'credito', 'cuentaCorriente'].forEach(method => {
                const methodDiv = document.querySelector(`.payment-method[onclick*="togglePaymentMethod('${method}')"]`) ||
                                 document.querySelector(`.payment-method[data-method="${method}"]`);
                if (methodDiv && methodDiv.classList.contains('selected')) {
                    hasSelectedMethod = true;
                    // Para cuenta corriente no se requiere monto, solo selección de cliente
                    if (method === 'cuentaCorriente') {
                        hasAmount = true; // Cuenta corriente no requiere monto específico
                    } else {
                        const amount = parseFloat(document.getElementById(`${method}-amount`).value) || 0;
                        if (amount > 0) hasAmount = true;
                    }
                }
            });

            if (!hasSelectedMethod) {
                showSmallAlert('Selecciona un método de pago', 'warning');
                return;
            }

            // Para cuenta corriente, verificar que haya cliente seleccionado
            if (Object.keys(selectedPaymentMethods).includes('cuentaCorriente') && !selectedCustomer) {
                showSmallAlert('Selecciona un cliente para Cuenta Corriente', 'warning');
                return;
            }

            // Para otros métodos, verificar montos
            if (!Object.keys(selectedPaymentMethods).includes('cuentaCorriente') && !hasAmount) {
                showSmallAlert('Ingresa el monto a pagar', 'warning');
                return;
            }

            // Si pasa validación, procesar pago normal
            processPayment();
        }

