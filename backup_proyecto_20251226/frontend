// Variable global para almacenar el pedido actual en confirmación
let currentDeliveryOrder = null;
// Variable para almacenar el estado anterior del pedido
let previousOrderStatus = null;

// Función para abrir modal de confirmación de llegada
async function openConfirmDeliveryModal(orderId) {
    try {
        // Obtener detalles del pedido
        const orderResponse = await window.ApiClient.apiRequest(`/supplier-orders/${orderId}`);
        currentDeliveryOrder = orderResponse;

        // Verificar si el pedido ya está entregado
        if (orderResponse.estado === 'entregado') {
            showAlert('❌ Este pedido ya fue confirmado como entregado anteriormente.', 'error');
            return;
        }

        // Almacenar el estado anterior para poder resetearlo si se cancela
        previousOrderStatus = orderResponse.estado;

        // Mostrar información del pedido
        document.getElementById('deliveryOrderInfo').style.display = 'block';
        document.getElementById('deliveryOrderDetails').innerHTML = `
            <strong>Pedido:</strong> ${orderResponse.numero_pedido} |
            <strong>Proveedor:</strong> ${orderResponse.nombre_proveedor} |
            <strong>Fecha:</strong> ${DateUtils.formatForDisplay(orderResponse.fecha_pedido, { dateStyle: 'short' })}
        `;

        // Cargar items del pedido
        await loadDeliveryItems(orderResponse.items);

        // Limpiar items extra
        document.getElementById('extraItemsContainer').innerHTML = '';

        // Mostrar modal
        document.getElementById('confirmDeliveryModal').classList.add('show');

        // Prevenir cierre del modal hasta completar o cancelar
        const modal = document.getElementById('confirmDeliveryModal');
        modal.style.pointerEvents = 'auto';

        // Prevenir cierre al hacer clic fuera
        const preventClose = (e) => {
            if (e.target === modal) {
                e.stopPropagation();
                showAlert('Debe completar la configuración de fechas o cancelar para cerrar el modal.', 'error');
            }
        };

        // Prevenir cierre con ESC
        const preventEscClose = (e) => {
            if (e.key === 'Escape') {
                e.preventDefault();
                showAlert('Debe completar la configuración de fechas o cancelar para cerrar el modal.', 'error');
            }
        };

        modal.addEventListener('click', preventClose);
        document.addEventListener('keydown', preventEscClose);

        // Almacenar las funciones para remover los listeners después
        modal._preventClose = preventClose;
        modal._preventEscClose = preventEscClose;

        // No establecer fecha automática - el usuario debe seleccionar la fecha de entrega real

    } catch (error) {
        console.error('Error cargando pedido para confirmación:', error);

        // Manejar específicamente el error 404 (pedido no encontrado)
        if (error.message && error.message.includes('404')) {
            showAlert('❌ El pedido solicitado no existe o ha sido eliminado. La lista de pedidos se actualizará automáticamente.', 'error');
            // Recargar la lista de pedidos para refrescar la UI
            if (typeof fetchSupplierOrders === 'function') {
                fetchSupplierOrders();
            }
        } else {
            showAlert('Error al cargar el pedido para confirmación: ' + error.message, 'error');
        }
    }
}

// Función para cerrar modal de confirmación de llegada (cancelar)
function closeConfirmDeliveryModal() {
    const modal = document.getElementById('confirmDeliveryModal');
    modal.classList.remove('show');

    // Remover listeners de prevención de cierre
    if (modal._preventClose) {
        modal.removeEventListener('click', modal._preventClose);
        delete modal._preventClose;
    }
    if (modal._preventEscClose) {
        document.removeEventListener('keydown', modal._preventEscClose);
        delete modal._preventEscClose;
    }

    // Resetear el selector al estado anterior si se canceló
    if (currentDeliveryOrder && previousOrderStatus) {
        const orderRow = document.querySelector(`tr[data-order-id="${currentDeliveryOrder.id}"]`);
        if (orderRow) {
            const statusSelector = orderRow.querySelector('.order-status-selector');
            if (statusSelector) {
                statusSelector.value = previousOrderStatus;
            }
        }
    }

    currentDeliveryOrder = null;
    previousOrderStatus = null;
    // Limpiar campo de fecha de entrega real
    document.getElementById('actualDeliveryDate').value = '';
}

