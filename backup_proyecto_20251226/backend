    return new Promise((resolve, reject) => {
        // Usar query sin removeAccents ya que la función no está disponible
        const cleanQuery = query.replace(/removeAccents\(([^)]+)\)/g, '$1');
        db.all(cleanQuery, params, (err, rows) => {
            if (err) reject(err);
            else resolve(rows);
        });
    });
}

