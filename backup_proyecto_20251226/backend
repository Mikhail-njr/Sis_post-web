                }
                const res = await fetch(`${API_BASE}/categories`, { headers });
                if (res.status === 401) {
                    // Silently fail - categories require authentication but don't prompt
                    return;
                }
                if (!res.ok) {
                    throw new Error(`Error ${res.status}: ${res.statusText}`);
