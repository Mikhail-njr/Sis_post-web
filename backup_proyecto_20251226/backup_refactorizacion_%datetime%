                total_esperado: totalEsperado,
                diferencia: diferencia,
                cantidad_ventas: dailySales[0].cantidad || 0
            }
        );

        res.json({
            success: true,
            dinero_inicial: initialAmount,
            dinero_contado: countedAmount,
            total: totalVentas,
            total_esperado: totalEsperado,
            diferencia: diferencia,
            cantidad_ventas: dailySales[0].cantidad || 0,
            ventas: processedSales,
