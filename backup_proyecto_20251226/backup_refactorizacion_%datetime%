        async function loadCuentaCorrienteSaldo(clienteId) {
            if (!clienteId) return;

            try {
                const headers = { 'Content-Type': 'application/json' };
                if (authCredentials) {
                    headers['Authorization'] = 'Basic ' + btoa(authCredentials.username + ':' + authCredentials.password);
                }

                const res = await fetch(`${API_BASE}/cuenta-corriente/${clienteId}/saldo`, { headers });
                if (res.status === 401) {
                    showAlert('❌ Autenticación requerida para consultar saldo', 'error');
                    return;
                }
                if (res.status === 404) {
                    // Cliente no tiene cuenta corriente - mostrar mensaje informativo
                    const saldoInfo = document.getElementById('cuenta_corriente-saldo');
                    saldoInfo.textContent = 'Cliente sin cuenta corriente';
                    saldoInfo.style.color = '#6c757d'; // Gris
                    cuentaCorrienteSaldo = 0;
                    showAlert('ℹ️ Este cliente no tiene cuenta corriente activa', 'info');
                    return;
                }
                if (!res.ok) {
                    throw new Error(`Error ${res.status}: ${res.statusText}`);
                }

                const data = await res.json();
                cuentaCorrienteSaldo = data.saldo || 0;

                const saldoInfo = document.getElementById('cuenta_corriente-saldo');
                saldoInfo.textContent = `Saldo: ${formatCurrency(cuentaCorrienteSaldo)}`;

                // Actualizar color según el saldo
                if (cuentaCorrienteSaldo >= 0) {
                    saldoInfo.style.color = '#27ae60'; // Verde
                } else {
                    saldoInfo.style.color = '#e74c3c'; // Rojo
                }

            } catch (error) {
                console.error('Error cargando saldo de cuenta corriente:', error);
                const saldoInfo = document.getElementById('cuenta_corriente-saldo');
                saldoInfo.textContent = 'Error al cargar saldo';
                saldoInfo.style.color = '#e74c3c';
            }
        }

        function confirmCuentaCorrientePayment() {
            if (!cuentaCorrienteCliente) {
                showAlert('❌ Selecciona un cliente para la cuenta corriente', 'error');
                return;
            }
        
            const total = calcularTotal();
            if (total <= 0) {
                showAlert('❌ El carrito está vacío', 'error');
                return;
            }
        
            // Obtener IDs de productos del carrito
            const productosIds = cart.map(item => item.id);
        
            // Mostrar confirmación con información de productos
            const productosInfo = cart.map(item => `• ${item.nombre} (ID: ${item.id})`).join('\n');
            const confirmMessage = `¿Confirmas el cargo de ${formatCurrency(total)} a la cuenta corriente de ${cuentaCorrienteCliente.nombre}?\n\nProductos:\n${productosInfo}\n\nTotal: ${formatCurrency(total)}`;
        
            if (confirm(confirmMessage)) {
                processCuentaCorrientePayment(total, productosIds);
            }
        }

        async function processCuentaCorrientePayment(total) {
            try {
                const headers = { 'Content-Type': 'application/json' };
                if (authCredentials) {
                    headers['Authorization'] = 'Basic ' + btoa(authCredentials.username + ':' + authCredentials.password);
                }

                const requestData = {
                    cliente_id: cuentaCorrienteCliente.id,
                    monto: total,
                    descripcion: `Cargo por venta ${new Date().toLocaleDateString('es-AR')}`
                };

                const res = await fetch(`${API_BASE}/cuenta-corriente/cargo`, {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify(requestData)
                });

                if (res.status === 401) {
                    showAlert('❌ Credenciales incorrectas', 'error');
                    return;
                }
                if (!res.ok) {
                    let errorMsg = 'Error al procesar el cargo';
                    try {
                        const errorData = await res.json();
                        errorMsg += ': ' + (errorData.error || res.statusText);
                    } catch (e) {
                        errorMsg += ': ' + res.statusText;
                    }
                    throw new Error(errorMsg);
                }

                const data = await res.json();

                // Procesar la venta normalmente
                const paymentDetails = [{ metodo: 'cuenta_corriente', monto: total }];
                generateInvoice(total, data.numero_factura, paymentDetails, 0, data.fecha);

                // Agregar la nueva venta al cache sin recargar
                const newSale = {
                    numero_factura: data.numero_factura,
                    total: total,
                    fecha: data.fecha || new Date().toISOString(),
                    items: cart.map(item => ({
                        nombre: item.nombre,
                        cantidad: item.cantidad,
                        precio_unitario: parseFloat(item.precio),
                        precio_original: parseFloat(item.precio_original || item.precio),
                        descuento_porcentaje: item.tiene_descuento ? item.descuento_porcentaje : 0
                    }))
                };
                addNewSaleToCache(newSale);

                // Limpiar carrito y cuenta corriente
                cart = [];
                updateCart();
                cuentaCorrienteCliente = null;
                cuentaCorrienteSaldo = 0;
                document.getElementById('cuenta_corriente-toggle').checked = false;
                document.getElementById('cuenta_corriente-client-info').style.display = 'none';
                document.getElementById('cuenta_corriente-saldo').style.display = 'none';
                document.getElementById('cuenta_corriente-confirm').style.display = 'none';

                showAlert('✅ Cargo a cuenta corriente exitoso', 'success');

                // Reproducir sonido de éxito de venta
                playSuccessSound();

                // Actualizar el saldo mostrado
                loadCuentaCorrienteSaldo(cuentaCorrienteCliente.id);

            } catch (error) {
                showAlert('❌ Error al procesar el cargo a cuenta corriente', 'error');
                console.error('Error en processCuentaCorrientePayment:', error);
            }
        }

        function calcularTotal() {
            // Verificar si cuenta corriente está activada
            const cuentaCorrienteToggle = document.getElementById('cuenta_corriente-toggle');
            const isCuentaCorrienteActive = cuentaCorrienteToggle && cuentaCorrienteToggle.checked;

            return cart.reduce((sum, item) => {
                // Si es cuenta corriente, usar precio original (sin descuento)
                // Si no es cuenta corriente, usar precio con descuento
                const precioAUtilizar = isCuentaCorrienteActive ?
                    (item.precio_original || item.precio) :
                    item.precio;
                return sum + (parseFloat(precioAUtilizar) * item.cantidad);
            }, 0);
        }

