        // Funciones específicas de index.html

        function openCustomerModal() {
            document.getElementById('customerModal').style.display = 'flex';
            document.getElementById('customerSearchInput').focus();
            loadCustomers();
        }

        function closeCustomerModal() {
            document.getElementById('customerModal').style.display = 'none';
            document.getElementById('customerSearchInput').value = '';
        }

        async function loadCustomers(searchTerm = '') {
            const customerList = document.getElementById('customerList');
            customerList.innerHTML = '<div style="text-align:center; padding:20px;">Cargando clientes...</div>';

            try {
                const headers = { 'Content-Type': 'application/json' };
                if (authCredentials) {
                    headers['Authorization'] = 'Basic ' + btoa(authCredentials.username + ':' + authCredentials.password);
                }

                let url = `${API_BASE}/customers`;
                if (searchTerm) {
                    url = `${API_BASE}/customers/search?q=${encodeURIComponent(searchTerm)}`;
                }

                const res = await fetch(url, { headers });
                if (res.status === 401) {
                    customerList.innerHTML = '<div style="text-align:center; padding:20px; color:#dc3545;">Autenticación requerida</div>';
                    return;
                }
                if (!res.ok) {
                    throw new Error(`Error ${res.status}: ${res.statusText}`);
                }

                const data = await res.json();
                const customers = data.customers || data;

                displayCustomers(customers);
            } catch (error) {
                console.error('Error loading customers:', error);
                customerList.innerHTML = '<div style="text-align:center; padding:20px; color:#dc3545;">Error al cargar clientes</div>';
            }
        }

        function displayCustomers(customers) {
            const customerList = document.getElementById('customerList');

            if (customers.length === 0) {
                customerList.innerHTML = '<div style="text-align:center; padding:20px; color:#7f8c8d;">No se encontraron clientes</div>';
                return;
            }

            customerList.innerHTML = customers.map(customer => `
                <div style="padding:10px; border-bottom:1px solid #eee; cursor:pointer;" onclick="selectCustomer(${customer.id}, '${customer.nombre.replace(/'/g, "\\'")}')">
                    <div style="font-weight:bold;">${customer.nombre}</div>
                    <div style="font-size:0.9em; color:#666;">
                        ${customer.telefono ? `📞 ${customer.telefono}` : ''}
                        ${customer.dni ? ` | 🆔 ${customer.dni}` : ''}
                    </div>
                    ${customer.direccion ? `<div style="font-size:0.8em; color:#999;">📍 ${customer.direccion}</div>` : ''}
                </div>
            `).join('');
        }

        function selectCustomer(customerId, customerName) {
            const cuentaCorrienteToggle = document.getElementById('cuenta_corriente-toggle');
            const isCuentaCorrienteMode = cuentaCorrienteToggle && cuentaCorrienteToggle.checked;

            if (customerId === null) {
                selectedCustomer = null;
                if (isCuentaCorrienteMode) {
                    cuentaCorrienteCliente = null;
                    cuentaCorrienteSaldo = 0;
                    document.getElementById('cuenta_corriente-client-info').style.display = 'none';
                    document.getElementById('cuenta_corriente-saldo').style.display = 'none';
                    document.getElementById('cuenta_corriente-confirm').style.display = 'none';
                }
            } else {
                selectedCustomer = { id: customerId, nombre: customerName };
                if (isCuentaCorrienteMode) {
                    setCuentaCorrienteCliente({ id: customerId, nombre: customerName });
                }
            }

            updateCustomerInfo();
            closeCustomerModal();

            if (selectedCustomer) {
                showAlert('✅ Cliente seleccionado: ' + selectedCustomer.nombre, 'success');
            } else {
                showAlert('Cliente no seleccionado', 'info');
            }
        }

        function updateCustomerInfo() {
            const infoElement = document.getElementById('selected-customer-info');
            if (infoElement) {
                if (selectedCustomer) {
                    infoElement.textContent = `(Cliente: ${selectedCustomer.nombre})`;
                    infoElement.style.display = 'inline';
                } else {
                    infoElement.style.display = 'none';
                }
            }
        }

        // Variables para cuenta corriente
        let cuentaCorrienteCliente = null;
        let cuentaCorrienteSaldo = 0;

        function toggleCuentaCorriente() {
            const checkbox = document.getElementById('cuenta_corriente-toggle');
            const clienteInfo = document.getElementById('cuenta_corriente-client-info');
            const saldoInfo = document.getElementById('cuenta_corriente-saldo');
            const confirmBtn = document.getElementById('cuenta_corriente-confirm');

            if (checkbox.checked) {
                if (cart.length === 0) {
