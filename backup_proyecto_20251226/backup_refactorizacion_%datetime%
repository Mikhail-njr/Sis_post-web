// Endpoint para calcular preview del cierre de caja
app.post('/api/close-register-preview', async (req, res) => {
    try {
        const { fecha, dineroInicial } = req.body;

        if (!fecha || !dineroInicial || isNaN(parseFloat(dineroInicial))) {
            return res.status(400).json({
                error: 'Fecha y dinero inicial son requeridos. Dinero inicial debe ser un número válido.'
            });
        }

        const initialMoney = parseFloat(dineroInicial);
        if (initialMoney < 0) {
            return res.status(400).json({ error: 'El dinero inicial no puede ser negativo.' });
        }

        // Obtener totales del día actual (usando zona horaria del sistema)
        const today = getCurrentSystemDate().toISOString().split('T')[0];

        // Obtener totales agregados para mejor rendimiento
        const totalsQuery = `
            SELECT
                SUM(total) as total,
                COUNT(*) as cantidad
            FROM ventas
            WHERE DATE(created_at, '+3 hours') = DATE(?)
        `;

        const totals = await dbAll(totalsQuery, [today]);
        const totalVentas = parseFloat(totals[0]?.total) || 0;
        const cantidadVentas = totals[0]?.cantidad || 0;

        // Obtener ventas del día para calcular totales por método de pago
        const salesQuery = `
            SELECT
                total,
                metodo_pago
            FROM ventas
            WHERE DATE(created_at, '+3 hours') = DATE(?)
            ORDER BY created_at DESC
        `;

        const sales = await dbAll(salesQuery, [today]);

        // Calcular totales por método de pago
        const paymentTotals = {};

        sales.forEach(sale => {
            // Agrupar por método de pago
            let metodoPago = sale.metodo_pago;
            if (metodoPago && typeof metodoPago === 'string') {
                // Intentar parsear JSON si contiene información detallada
                try {
                    const parsed = JSON.parse(metodoPago);
                    if (Array.isArray(parsed) && parsed.length > 0 && parsed[0].metodo) {
                        // Es un array de pagos detallados, sumar todos
                        parsed.forEach(pago => {
                            const metodo = pago.metodo || 'Desconocido';
                            paymentTotals[metodo] = (paymentTotals[metodo] || 0) + parseFloat(pago.monto || 0);
                        });
                        return;
                    }
                } catch (e) {
                    // No es JSON, usar como string simple
                }

                // Método de pago simple
                paymentTotals[metodoPago] = (paymentTotals[metodoPago] || 0) + parseFloat(sale.total);
            }
        });

        const totalEsperado = initialMoney + totalVentas;
        const diferencia = 0; // En preview, la diferencia es 0 hasta que se confirme

        const result = {
            fecha: fecha,
            fecha_cierre: today,
            dinero_inicial: initialMoney,
            total_ventas: totalVentas,
            total_esperado: totalEsperado,
            diferencia: diferencia,
            cantidad_ventas: cantidadVentas,
            tipo_cierre: 'normal',
            payment_totals: Object.keys(paymentTotals).length > 0 ? paymentTotals : null
        };

        // Registrar operación de cálculo
        logOperation(
            'CIERRE_PREVIEW',
            `Cálculo de cierre de caja para ${today} - Ventas: ${cantidadVentas} - Total esperado: ${formatCurrency(totalEsperado)}`,
            'Sistema',
            'cierres_caja',
            null,
            null,
            result
        );

        res.json(result);

    } catch (error) {
        console.error('Error calculando preview de cierre de caja:', error);
        res.status(500).json({ error: 'Error interno del servidor: ' + error.message });
    }
});

