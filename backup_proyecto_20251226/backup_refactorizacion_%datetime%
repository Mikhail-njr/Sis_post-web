// 1. Registrar un cargo (venta a cuenta corriente)
app.post('/api/cuenta-corriente/cargo', conditionalAuth, async (req, res) => {
    const { cliente_id, monto, descripcion, productos_ids } = req.body;

    // Validaciones
    if (!cliente_id || !monto || monto <= 0) {
        return res.status(400).json({ error: 'Cliente y monto son requeridos' });
    }

    try {
        // Verificar cliente
        const cliente = await dbAll("SELECT id FROM clientes WHERE id = ?", [cliente_id]);
        if (cliente.length === 0) {
            return res.status(404).json({ error: 'Cliente no encontrado' });
        }

        // Obtener o crear cuenta corriente
        let cuenta = await dbAll("SELECT * FROM cuentas_corrientes WHERE cliente_id = ?", [cliente_id]);

        if (cuenta.length === 0) {
            // Crear nueva cuenta corriente
            const result = await dbRun(
                "INSERT INTO cuentas_corrientes (cliente_id, saldo) VALUES (?, ?)",
                [cliente_id, monto]
            );
            cuenta = [{ id: result.id, saldo: monto }];
        } else {
            // Actualizar saldo existente
            await dbRun(
                "UPDATE cuentas_corrientes SET saldo = saldo + ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?",
                [monto, cuenta[0].id]
            );
            cuenta[0].saldo += monto;
        }

        // Preparar referencia_id con los IDs de productos si se proporcionan
        let referenciaId = null;
        if (productos_ids && Array.isArray(productos_ids) && productos_ids.length > 0) {
            // Almacenar los IDs de productos como JSON en el campo referencia_id
            referenciaId = JSON.stringify(productos_ids);
        }

        // Registrar movimiento
        await dbRun(
            "INSERT INTO movimientos_cuenta_corriente (cuenta_corriente_id, tipo_movimiento, monto, descripcion, referencia_id) VALUES (?, ?, ?, ?, ?)",
            [cuenta[0].id, 'cargo', monto, descripcion || 'Venta a cuenta corriente', referenciaId]
        );

        res.status(201).json({
            success: true,
            message: 'Cargo registrado exitosamente',
            cuenta_id: cuenta[0].id,
            nuevo_saldo: cuenta[0].saldo,
            productos_registrados: productos_ids ? productos_ids.length : 0
        });

    } catch (error) {
        console.error('Error registrando cargo:', error);
        res.status(500).json({ error: 'Error interno del servidor' });
    }
});

// 2. Registrar un abono (pago parcial o total)
app.post('/api/cuenta-corriente/abono', conditionalAuth, async (req, res) => {
    const { cliente_id, monto, descripcion } = req.body;

    // Validaciones
    if (!cliente_id || !monto || monto <= 0) {
        return res.status(400).json({ error: 'Cliente y monto son requeridos' });
    }

    try {
        // Verificar cliente y cuenta
        const cuenta = await dbAll(`
            SELECT cc.* FROM cuentas_corrientes cc
            JOIN clientes c ON cc.cliente_id = c.id
            WHERE cc.cliente_id = ?
        `, [cliente_id]);

        if (cuenta.length === 0) {
            return res.status(404).json({ error: 'Cliente no tiene cuenta corriente' });
        }

        const cuentaActual = cuenta[0];

        // Verificar que el monto no exceda el saldo
        if (monto > cuentaActual.saldo) {
            return res.status(400).json({
                error: `El monto del pago (${formatCurrency(monto)}) no puede ser mayor al saldo (${formatCurrency(cuentaActual.saldo)})`
            });
        }

        // Actualizar saldo
        const nuevoSaldo = cuentaActual.saldo - monto;
        await dbRun(
            "UPDATE cuentas_corrientes SET saldo = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?",
            [nuevoSaldo, cuentaActual.id]
        );

        // Registrar movimiento
        await dbRun(
            "INSERT INTO movimientos_cuenta_corriente (cuenta_corriente_id, tipo_movimiento, monto, descripcion) VALUES (?, ?, ?, ?)",
            [cuentaActual.id, 'abono', monto, descripcion || 'Pago a cuenta corriente']
        );

        res.json({
            success: true,
            message: 'Abono registrado exitosamente',
            cuenta_id: cuentaActual.id,
            nuevo_saldo: nuevoSaldo,
            pagado: monto
        });

    } catch (error) {
        console.error('Error registrando abono:', error);
        res.status(500).json({ error: 'Error interno del servidor' });
    }
});

