// Actualizar lote
app.put('/api/lotes/:id', async (req, res) => {
    const loteId = req.params.id;
    const { numero_lote, fecha_vencimiento, costo_unitario, notas } = req.body;

    try {
        // Verificar que el lote existe
        const existingLote = await dbAll("SELECT * FROM lotes WHERE id = ?", [loteId]);
        if (existingLote.length === 0) {
            return res.status(404).json({ error: 'Lote no encontrado' });
        }

        // Obtener datos anteriores para el log
        const oldLote = existingLote[0];

        // Construir consulta de actualización dinámicamente
        const updates = [];
        const params = [];

        if (numero_lote !== undefined) {
            // Verificar que el nuevo número no exista para el mismo producto (incluyendo lotes inactivos)
            const duplicateLote = await dbAll("SELECT id FROM lotes WHERE producto_id = ? AND numero_lote = ? AND id != ?",
                [oldLote.producto_id, numero_lote, loteId]);
            if (duplicateLote.length > 0) {
                return res.status(400).json({ error: 'Ya existe otro lote con este número para este producto' });
            }
            updates.push("numero_lote = ?");
            params.push(numero_lote);
        }

        if (fecha_vencimiento !== undefined) {
            const fechaVenc = new Date(fecha_vencimiento);
            if (isNaN(fechaVenc.getTime())) {
                return res.status(400).json({ error: 'Fecha de vencimiento inválida' });
            }
            updates.push("fecha_vencimiento = ?");
            params.push(fecha_vencimiento);
        }

        if (costo_unitario !== undefined) {
            updates.push("costo_unitario = ?");
            params.push(costo_unitario);
        }

        if (notas !== undefined) {
            updates.push("notas = ?");
            params.push(notas);
        }

        if (updates.length === 0) {
            return res.status(400).json({ error: 'No se proporcionaron campos para actualizar' });
        }

        params.push(loteId);
        const query = `UPDATE lotes SET ${updates.join(", ")} WHERE id = ?`;
        const result = await dbRun(query, params);

        if (result.changes === 0) {
            return res.status(404).json({ error: 'Lote no encontrado' });
        }

        // Registrar la operación en el log
        const changes = [];
        if (numero_lote !== undefined && oldLote.numero_lote !== numero_lote) changes.push(`número: ${oldLote.numero_lote} → ${numero_lote}`);
        if (fecha_vencimiento !== undefined && oldLote.fecha_vencimiento !== fecha_vencimiento) changes.push(`vencimiento: ${oldLote.fecha_vencimiento} → ${fecha_vencimiento}`);
        if (costo_unitario !== undefined && oldLote.costo_unitario !== costo_unitario) changes.push(`costo: ${oldLote.costo_unitario} → ${costo_unitario}`);

        if (changes.length > 0) {
            logOperation(
                'LOTE_EDITADO',
                `Lote editado: ${changes.join(', ')}`,
                'Sistema',
                'lotes',
                loteId,
                oldLote,
                { numero_lote, fecha_vencimiento, costo_unitario, notas }
            );
        }

        res.json({
            success: true,
            message: 'Lote actualizado exitosamente'
        });

    } catch (error) {
        console.error('Error actualizando lote:', error);
        res.status(500).json({ error: 'Error interno del servidor: ' + error.message });
    }
});

// Eliminar lote (permite eliminar lotes con stock)
app.delete('/api/lotes/:id', async (req, res) => {
    try {
        const loteId = req.params.id;

        // Verificar que el lote existe
        const existingLote = await dbAll("SELECT * FROM lotes WHERE id = ?", [loteId]);
        if (existingLote.length === 0) {
            return res.status(404).json({ error: 'Lote no encontrado' });
        }

        const lote = existingLote[0];

        // Iniciar transacción para asegurar consistencia
        await dbRun("BEGIN TRANSACTION");

        try {
            // Si el lote tiene stock, reducir el stock total del producto
            if (lote.cantidad_actual > 0) {
                await dbRun(
                    "UPDATE productos SET stock = stock - ? WHERE id = ?",
                    [lote.cantidad_actual, lote.producto_id]
                );
            }

            // Marcar como inactivo en lugar de eliminar físicamente
            await dbRun("UPDATE lotes SET estado = 'inactivo' WHERE id = ?", [loteId]);

            // Verificar si necesitamos actualizar lote_actual_id del producto
            const loteMasVigente = await dbAll(`
                SELECT id FROM lotes
                WHERE producto_id = ? AND estado = 'activo' AND cantidad_actual > 0 AND id != ?
                ORDER BY fecha_vencimiento DESC
                LIMIT 1
            `, [lote.producto_id, loteId]);

            if (loteMasVigente.length > 0) {
                await dbRun(
                    "UPDATE productos SET lote_actual_id = ? WHERE id = ?",
                    [loteMasVigente[0].id, lote.producto_id]
                );
            } else {
                // No hay más lotes activos, limpiar lote_actual_id
                await dbRun(
                    "UPDATE productos SET lote_actual_id = NULL WHERE id = ?",
                    [lote.producto_id]
                );
            }

            await dbRun("COMMIT");


            // Registrar la operación en el log
            logOperation(
                'LOTE_ELIMINADO',
                `Lote eliminado: ${lote.numero_lote} (Producto ID: ${lote.producto_id}) - Stock eliminado: ${lote.cantidad_actual}`,
                'Sistema',
                'lotes',
                loteId,
                lote,
                null
            );

            res.json({
                success: true,
                message: 'Lote eliminado exitosamente'
            });

        } catch (error) {
            await dbRun("ROLLBACK");
            throw error;
        }

    } catch (error) {
        console.error('Error eliminando lote:', error);
        res.status(500).json({ error: 'Error interno del servidor: ' + error.message });
    }
});

