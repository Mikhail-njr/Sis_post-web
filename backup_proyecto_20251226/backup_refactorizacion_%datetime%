app.delete('/api/customers/:id', async (req, res) => {
    try {
        const customerId = req.params.id;

        // Verificar que el cliente existe antes de proceder
        const customer = await dbAll("SELECT id, nombre FROM clientes WHERE id = ?", [customerId]);
        if (customer.length === 0) {
            return res.status(404).json({ error: 'Cliente no encontrado' });
        }

        // Iniciar transacción para eliminación en cascada
        await dbRun("BEGIN TRANSACTION");

        try {
            // 1. Eliminar movimientos de cuenta corriente asociados
            await dbRun(`
                DELETE FROM movimientos_cuenta_corriente
                WHERE cuenta_corriente_id IN (
                    SELECT id FROM cuentas_corrientes WHERE cliente_id = ?
                )
            `, [customerId]);

            // 2. Eliminar cuenta corriente del cliente
            await dbRun("DELETE FROM cuentas_corrientes WHERE cliente_id = ?", [customerId]);

            // 3. Eliminar productos de deudas asociados (aunque tenga CASCADE, por seguridad)
            await dbRun(`
                DELETE FROM deuda_productos
                WHERE deuda_id IN (
                    SELECT id FROM deudas WHERE cliente_id = ?
                )
            `, [customerId]);

            // 4. Eliminar deudas del cliente
            await dbRun("DELETE FROM deudas WHERE cliente_id = ?", [customerId]);

            // 5. Finalmente, eliminar el cliente
            const result = await dbRun("DELETE FROM clientes WHERE id = ?", [customerId]);

            // Confirmar transacción
            await dbRun("COMMIT");

            // Registrar la operación en el log
            logOperation(
                'CLIENTE_ELIMINADO',
                `Cliente eliminado completamente: ${customer[0].nombre} (ID: ${customerId}) - Eliminación en cascada de deudas, cuenta corriente y movimientos`,
                'Sistema',
                'clientes',
                customerId,
                customer[0],
                null
            );

            res.json({
                success: true,
                message: 'Cliente y todos sus datos relacionados eliminados exitosamente'
            });

        } catch (error) {
            // Revertir transacción en caso de error
            await dbRun("ROLLBACK");
            throw error;
        }

    } catch (error) {
        console.error('Error eliminando cliente:', error);
        res.status(500).json({ error: 'Error interno del servidor: ' + error.message });
    }
});

