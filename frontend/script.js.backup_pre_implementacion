                        <div style="color: #90ee90; font-weight: bold; font-size: 18px;">${formatCurrency(sale.total)}</div>
                        <div style="color: #cccccc; font-size: 12px;">${metodoPagoText}</div>
                    </div>
                    <div class="collapse-icon" style="margin-left: 10px; font-size: 18px; color: #666;">▼</div>
                </div>
                ${itemsHtml}
                <div class="invoice-total" style="margin-top: 10px; padding-top: 10px; border-top: 1px solid #666; text-align: right; color: #ffffff; font-weight: bold;">
