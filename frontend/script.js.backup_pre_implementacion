// Función para configurar eventos del dropdown de cierres
function setupCierreDropdownEvents() {
    const cierreSelect = document.getElementById('cierre-select');
    const viewBtn = document.getElementById('view-cierre-btn');
    const clearBtn = document.getElementById('clear-cierre-selection-btn');

    if (cierreSelect) {
        cierreSelect.addEventListener('change', function() {
            const selectedIndex = this.value;
            if (selectedIndex !== '') {
                viewBtn.disabled = false;
                // Resaltar la fila correspondiente en la tabla
                highlightCierreRow(selectedIndex);
            } else {
                viewBtn.disabled = true;
                clearCierreHighlight();
            }
        });
    }

    if (viewBtn) {
        viewBtn.addEventListener('click', function() {
            const selectedIndex = cierreSelect.value;
            if (selectedIndex !== '') {
                showCierreDetails(selectedIndex);
            }
        });
    }

    if (clearBtn) {
        clearBtn.addEventListener('click', function() {
            cierreSelect.value = '';
            viewBtn.disabled = true;
            clearCierreHighlight();
        });
    }
}

