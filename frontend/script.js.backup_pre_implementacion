    // Métodos para cargar secciones específicas (usando el nuevo sistema)
    async loadSalesSection(contentElement) {
        // Las ventas ya se cargan en fetchMetrics, pero podemos forzar una carga específica aquí si es necesario
        console.log('Cargando sección de ventas (orchestrator)');
        // El contenido ya está disponible en el DOM, solo necesitamos mostrarlo
    },

    async loadProductsSection(contentElement) {
        console.log('Cargando sección de productos (orchestrator)');
        const cachedData = LoadingSystem.cache.get('dashboard');
        if (cachedData && cachedData.products) {
            displayProductsTable(cachedData.products, currentSortBy, currentSortOrder);
        }
    },

    async loadLotesSection(contentElement) {
        console.log('Cargando sección de lotes (orchestrator)');
        const cachedData = LoadingSystem.cache.get('dashboard');
        if (cachedData && cachedData.lotes) {
            displayLotesTable(cachedData.lotes);
        }
    },

    async loadProveedoresSection(contentElement) {
        console.log('Cargando sección de proveedores (orchestrator)');

        // Verificar caché
        const cachedSuppliers = LoadingSystem.cache.get('suppliers');
        const cachedOrders = LoadingSystem.cache.get('supplierOrders');

        if (cachedSuppliers && cachedOrders) {
            console.log('✅ Usando datos de proveedores del caché');
            displaySuppliersTable(cachedSuppliers);
            displaySupplierOrdersTable(cachedOrders);
        } else {
            console.log('⏳ Datos de proveedores no válidos, forzando refresh');
            // Forzar refresh usando las funciones refactorizadas
            await fetchSuppliers(true);
            await fetchSupplierOrders(true);
        }
    },

    async loadHistorialCierresSection(contentElement) {
        console.log('Cargando sección de historial de cierres (orchestrator)');
        const cachedData = LoadingSystem.cache.get('dashboard');
        if (cachedData && cachedData.cierres) {
            const cierres = cachedData.cierres;

