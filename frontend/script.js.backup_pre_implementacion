// Mostrar estado de carga inicial
function showInitialLoadingState() {
    // Verificar si ya existe un overlay de carga
    const existingOverlay = document.getElementById('initial-loading-overlay');
    if (existingOverlay) {
        return; // No crear otro overlay si ya existe
    }

    const loadingOverlay = document.createElement('div');
    loadingOverlay.id = 'initial-loading-overlay';
    loadingOverlay.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.95);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
    `;

    loadingOverlay.innerHTML = `
        <div style="text-align: center;">
            <div style="font-size: 48px; margin-bottom: 20px;">📊</div>
            <div style="font-size: 18px; color: #666; margin-bottom: 10px;">Cargando Dashboard</div>
            <div style="font-size: 14px; color: #999;">Optimizando rendimiento...</div>
            <div style="margin-top: 20px;">
                <div style="width: 200px; height: 4px; background: #f0f0f0; border-radius: 2px; overflow: hidden;">
                    <div id="loading-progress" style="width: 0%; height: 100%; background: linear-gradient(90deg, #007bff, #28a745); border-radius: 2px; transition: width 0.3s ease;"></div>
                </div>
            </div>
        </div>
    `;

    document.body.appendChild(loadingOverlay);

    // Animar barra de progreso
    let progress = 0;
    const progressInterval = setInterval(() => {
        const progressElement = document.getElementById('loading-progress');
        if (!progressElement) {
            clearInterval(progressInterval);
            return;
        }

        progress += Math.random() * 15;
        if (progress > 90) progress = 90;
        progressElement.style.width = progress + '%';

        if (progress >= 90) {
            clearInterval(progressInterval);
        }
    }, 200);

    // Almacenar el ID del intervalo en el overlay para poder limpiarlo después
    loadingOverlay._progressInterval = progressInterval;
}

// Ocultar estado de carga inicial
function hideInitialLoadingState() {
    const overlay = document.getElementById('initial-loading-overlay');
    if (overlay) {
        // Limpiar el intervalo si existe
        if (overlay._progressInterval) {
            clearInterval(overlay._progressInterval);
        }

        // Completar barra de progreso
        const progressElement = document.getElementById('loading-progress');
        if (progressElement) {
            progressElement.style.width = '100%';
        }

        setTimeout(() => {
            overlay.style.opacity = '0';
            setTimeout(() => overlay.remove(), 300);
        }, 200);
    }
}

