// Obtener y mostrar métricas de ventas usando el nuevo sistema de carga
async function fetchMetrics(forceRefresh = false) {
    return LoadingSystem.executeOperation('fetchMetrics', async () => {
        console.log('📊 Obteniendo métricas del dashboard...');

        try {
            // Obtener todos los datos del dashboard en una sola llamada
            const dashboardData = await window.ApiClient.apiRequest('/dashboard-data');

            // Procesar datos críticos inmediatamente (estadísticas, alertas)
            processDashboardData(dashboardData);

            // Cargar secciones pesadas de manera diferida
            setTimeout(() => {
                loadHeavySectionsFromCache(dashboardData);
            }, 100);

            console.log('✅ Datos críticos del dashboard cargados exitosamente');
            return dashboardData;

        } catch (error) {
            console.error('Error obteniendo datos del dashboard:', error);
            // Fallback: intentar cargar datos individualmente si falla el endpoint consolidado
            console.log('Intentando fallback con llamadas individuales...');
            await fetchMetricsFallback();
            throw error;
        }
    }, {
        allowConcurrent: false,
        showGlobalLoader: !LoadOrchestrator.initialized, // Solo mostrar global loader si no está inicializado
        globalLoaderText: 'Cargando métricas del dashboard...',
        useCache: !forceRefresh,
        cacheKey: 'dashboard',
        forceRefresh
    });
}

