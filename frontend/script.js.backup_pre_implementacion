// Función para cargar productos en el select del item
async function loadProductsForOrder(selectElement) {
    try {
        const headers = { 'Content-Type': 'application/json' };
        if (authCredentials) {
            headers['Authorization'] = 'Basic ' + btoa(authCredentials.username + ':' + authCredentials.password);
        }
        const response = await fetch(`${API_BASE}/products`, { headers });
        if (response.status === 401) {
            isLoggedIn = false;
            updateUIBasedOnAuth();
            throw new Error('Autenticación requerida');
        }
        if (!response.ok) throw new Error('Error al obtener productos');
        const products = await response.json();

        selectElement.innerHTML = '<option value="">Seleccionar producto...</option>';

        // Para cada producto, usar el costo del lote más reciente incluido en la respuesta
        products.forEach(product => {
            // Usar costo_lote_mas_reciente si está disponible, sino usar precio de venta
            const costoLote = product.costo_lote_mas_reciente !== null && product.costo_lote_mas_reciente !== undefined ?
                product.costo_lote_mas_reciente : product.precio;

            const option = document.createElement('option');
            option.value = product.id;
            option.textContent = `${product.nombre} (${product.codigo}) [${product.codigo_barras || 'Sin código'}]`;
            option.dataset.price = costoLote;
            selectElement.appendChild(option);
        });
    } catch (error) {
        console.error('Error loading products for order:', error);
