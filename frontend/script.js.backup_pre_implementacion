// Load Orchestrator para coordinar todas las operaciones de carga
const LoadOrchestrator = {
    // Estado del orchestrator
    initialized: false,
    criticalDataLoaded: false,
    sectionsLoaded: new Set(),

    // Configuración de carga
    loadConfig: {
        critical: ['dashboard'], // Datos críticos que bloquean la UI
        sections: ['suppliers', 'supplierOrders', 'products', 'lotes', 'cierres'], // Secciones lazy
        priorities: {
            dashboard: 1,
            suppliers: 2,
            supplierOrders: 2,
            products: 3,
            lotes: 3,
            cierres: 4
        }
    },

    // Inicializar orchestrator
    async init() {
        if (this.initialized) return;
        console.log('🎼 Inicializando Load Orchestrator');

        try {
            // Fase 1: Mostrar carga inicial
            LoadingSystem.showGlobalLoader('Inicializando Dashboard', 'Cargando datos críticos...');
            LoadingSystem.updateGlobalProgress(10);

            // Fase 2: Cargar datos críticos
            await this.loadCriticalData();
            LoadingSystem.updateGlobalProgress(50);

            // Fase 3: Mostrar UI básica
            hideInitialLoadingState();
            showDashboardContent();
            LoadingSystem.updateGlobalProgress(70);

            // Fase 4: Inicializar lazy loading
            this.initLazyLoading();
            LoadingSystem.updateGlobalProgress(90);

            // Fase 5: Cargar sección por defecto (ventas)
            await this.loadDefaultSection();
            LoadingSystem.updateGlobalProgress(100);

            // Completar inicialización
            setTimeout(() => LoadingSystem.hideGlobalLoader(), 500);
            this.initialized = true;

            console.log('✅ Load Orchestrator inicializado exitosamente');

        } catch (error) {
            console.error('❌ Error en Load Orchestrator:', error);
            LoadingSystem.hideGlobalLoader();
            // Fallback a carga normal
            await fetchMetrics();
        }
    },

    // Cargar datos críticos
    async loadCriticalData() {
        console.log('🔍 Cargando datos críticos...');

        try {
            // Intentar cargar desde caché primero
            const cachedData = LoadingSystem.cache.get('dashboard');
            if (cachedData) {
                processDashboardData(cachedData);
                this.criticalDataLoaded = true;
                console.log('✅ Datos críticos cargados desde caché');
                return;
            }

            // Si no hay caché, cargar desde API
            const data = await window.ApiClient.apiRequest('/dashboard-data');
            processDashboardData(data);
            LoadingSystem.cache.set('dashboard', data);
            this.criticalDataLoaded = true;

            console.log('✅ Datos críticos cargados desde API');

        } catch (error) {
            console.warn('⚠️ Error cargando datos críticos:', error);
            this.criticalDataLoaded = false;
            throw error;
        }
    },

    // Inicializar lazy loading para secciones
    initLazyLoading() {
        console.log('🔄 Inicializando lazy loading...');

        const sectionHeaders = document.querySelectorAll('.section-header');
        sectionHeaders.forEach(header => {
            header.addEventListener('click', (e) => {
                const section = header.parentElement;
                const sectionId = section.id;
                this.handleSectionToggle(sectionId, section);
            });
        });
    },

    // Manejar toggle de sección
    async handleSectionToggle(sectionId, section) {
        const content = section.querySelector('.section-content');
        const isCollapsed = section.classList.contains('collapsed');
        const isLoaded = content.getAttribute('data-loaded') === 'true';

        // Si se está expandiendo y no está cargado, cargar contenido
        if (!isCollapsed && !isLoaded) {
            await this.loadSection(sectionId, content);
            content.setAttribute('data-loaded', 'true');
        }
    },

    // Cargar sección específica
    async loadSection(sectionId, contentElement) {
        console.log(`📦 Cargando sección: ${sectionId}`);

        try {
            LoadingSystem.showSectionLoader(sectionId, true);

            switch (sectionId) {
                case 'ventas-section':
                    await this.loadSalesSection(contentElement);
                    break;
                case 'productos-section':
                    await this.loadProductsSection(contentElement);
                    break;
                case 'lotes-section':
                    await this.loadLotesSection(contentElement);
                    break;
                case 'proveedores-section':
                    await this.loadProveedoresSection(contentElement);
                    break;
                case 'historial-cierres-section':
                    await this.loadHistorialCierresSection(contentElement);
                    break;
                case 'metricas-section':
                    await this.loadMetricasSection(contentElement);
                    break;
                case 'promociones-section':
                    await this.loadPromocionesSection(contentElement);
                    break;
                case 'operations-log-section':
                    await this.loadOperationsLogSection(contentElement);
                    break;
                default:
                    console.log(`Sección ${sectionId} no requiere carga específica`);
            }

            this.sectionsLoaded.add(sectionId);
            console.log(`✅ Sección ${sectionId} cargada`);

        } catch (error) {
            console.error(`❌ Error cargando sección ${sectionId}:`, error);
            const loadingElement = contentElement.querySelector('.loading');
            if (loadingElement) {
                loadingElement.textContent = 'Error al cargar la sección';
            }
        } finally {
            LoadingSystem.showSectionLoader(sectionId, false);
        }
    },

    // Cargar sección por defecto (ventas)
    async loadDefaultSection() {
        console.log('📊 Cargando sección por defecto (ventas)');
        const ventasSection = document.getElementById('ventas-section');
        if (ventasSection) {
            await this.loadSection('ventas-section', ventasSection.querySelector('.section-content'));
        }
