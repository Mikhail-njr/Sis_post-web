/**
 * Función unificada para cargar datos de proveedores y pedidos con logging mejorado
 * @param {boolean} forceRefresh - Forzar refresh de datos desde el servidor
 * @param {string} loadPriority - Prioridad de carga ('suppliers-first', 'orders-first', 'parallel')
 * @returns {Promise<Object>} - Objeto con proveedores y pedidos
 */
async function fetchSupplierData(forceRefresh = false, loadPriority = 'parallel') {
    const operationId = 'fetchSupplierData';
    const startTime = Date.now();
    const operationStart = new Date().toISOString();

    // Logging inicial con detalles
    console.log(`🚀 [${operationId}] Iniciando carga coordinada de proveedores/pedidos`);
    console.log(`📊 [${operationId}] Parámetros: forceRefresh=${forceRefresh}, loadPriority=${loadPriority}`);
    console.log(`🕒 [${operationId}] Hora de inicio: ${operationStart}`);

    try {
        // Verificar caché primero
        if (!forceRefresh) {
            const cachedSuppliers = LoadingSystem.cache.get('suppliers');
            const cachedOrders = LoadingSystem.cache.get('supplierOrders');

            if (cachedSuppliers && cachedOrders) {
                const cacheHitTime = Date.now();
                console.log(`✅ [${operationId}] Éxito en caché: ambos datasets disponibles`);
                console.log(`📊 [${operationId}] Proveedores en caché: ${cachedSuppliers.length}, Pedidos en caché: ${cachedOrders.length}`);
                console.log(`⏱️ [${operationId}] Tiempo de respuesta de caché: ${cacheHitTime - startTime}ms`);

                return {
                    suppliers: cachedSuppliers,
                    supplierOrders: cachedOrders,
                    source: 'cache',
                    loadTime: cacheHitTime - startTime,
                    operationId: operationId,
                    timestamp: operationStart
                };
            } else {
                console.log(`⚠️ [${operationId}] Fallo parcial en caché: proveedores=${!!cachedSuppliers}, pedidos=${!!cachedOrders}`);
            }
        } else {
            console.log(`🔄 [${operationId}] ForceRefresh activado: ignorando caché`);
        }

        // Si no hay caché válido, cargar desde el dashboard
        console.log(`🔄 [${operationId}] Iniciando carga desde dashboard...`);

        // Cargar datos del dashboard (esto obtendrá ambos: proveedores y pedidos)
        const dashboardLoadStart = Date.now();
        const dashboardData = await LoadingSystem.executeOperation(
            'fetchMetrics',
            () => fetchMetrics(true),
            {
                showGlobalLoader: false,
                globalLoaderText: 'Cargando datos de proveedores...',
                useCache: false,
                forceRefresh: true
            }
        );
        const dashboardLoadTime = Date.now() - dashboardLoadStart;

        console.log(`📊 [${operationId}] Dashboard cargado en ${dashboardLoadTime}ms`);

        // Extraer datos específicos
        const suppliers = dashboardData.suppliers || [];
        const supplierOrders = dashboardData.supplierOrders || [];

        // Validar datos recibidos
        if (suppliers.length === 0) {
            console.warn(`⚠️ [${operationId}] Advertencia: no se recibieron proveedores en la respuesta`);
        }
        if (supplierOrders.length === 0) {
            console.warn(`⚠️ [${operationId}] Advertencia: no se recibieron pedidos en la respuesta`);
        }

        // Almacenar en caché individual
        const cacheSetStart = Date.now();
        LoadingSystem.cache.set('suppliers', suppliers);
        LoadingSystem.cache.set('supplierOrders', supplierOrders);
        const cacheSetTime = Date.now() - cacheSetStart;

        console.log(`💾 [${operationId}] Datos almacenados en caché en ${cacheSetTime}ms`);

        const totalLoadTime = Date.now() - startTime;
        console.log(`✅ [${operationId}] Operación completada con éxito`);
        console.log(`📊 [${operationId}] Estadísticas finales:`);
        console.log(`   - Proveedores: ${suppliers.length} registros`);
        console.log(`   - Pedidos: ${supplierOrders.length} registros`);
        console.log(`   - Fuente: dashboard`);
        console.log(`   - Tiempo total: ${totalLoadTime}ms`);
        console.log(`   - Desglose: ${dashboardLoadTime}ms (dashboard) + ${cacheSetTime}ms (caché)`);

        return {
            suppliers: suppliers,
            supplierOrders: supplierOrders,
            source: 'dashboard',
            loadTime: totalLoadTime,
            operationId: operationId,
            timestamp: operationStart,
            dashboardLoadTime: dashboardLoadTime,
            cacheSetTime: cacheSetTime
        };

    } catch (error) {
        const errorTime = Date.now();
        console.error(`❌ [${operationId}] Error en operación después de ${errorTime - startTime}ms:`, error);
        console.error(`🔍 [${operationId}] Stack trace:`, error.stack);

        // Intentar fallback: cargar datos individualmente si el dashboard falla
        try {
            console.log(`🔄 [${operationId}] Intentando fallback con llamadas individuales...`);

            const fallbackStart = Date.now();
            const suppliers = await window.ApiClient.apiRequest('/suppliers');
            const supplierOrders = await window.ApiClient.apiRequest('/supplier-orders');
            const fallbackTime = Date.now() - fallbackStart;

            console.log(`🆘 [${operationId}] Fallback exitoso en ${fallbackTime}ms`);
            console.log(`📊 [${operationId}] Datos de fallback: ${suppliers.length} proveedores, ${supplierOrders.length} pedidos`);

            return {
                suppliers: suppliers,
                supplierOrders: supplierOrders,
                source: 'fallback',
                loadTime: fallbackTime,
                operationId: operationId,
                timestamp: operationStart,
                isFallback: true
            };

        } catch (fallbackError) {
            console.error(`❌ [${operationId}] Fallback también falló:`, fallbackError);
            throw new Error(`Error principal: ${error.message}. Fallback fallido: ${fallbackError.message}`);
        }
    }
}

