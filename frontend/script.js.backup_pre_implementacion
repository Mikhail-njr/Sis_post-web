        container.style.display = 'none';
        loading.textContent = 'No hay ventas registradas para las fechas seleccionadas.';
        loading.style.display = 'block';
    }
}

// Función para alternar detalles de factura
function toggleInvoiceDetails(headerElement) {
    const card = headerElement.closest('.invoice-card');
    const items = card.querySelector('.invoice-items');
    const total = card.querySelector('.invoice-total');
    const icon = headerElement.querySelector('.collapse-icon');

    if (items && total) {
        const isCollapsed = items.style.display === 'none';
        items.style.display = isCollapsed ? 'block' : 'none';
        total.style.display = isCollapsed ? 'block' : 'none';
        icon.textContent = isCollapsed ? '▲' : '▼';
        card.classList.toggle('collapsed', !isCollapsed);
    }
}

// Función para cargar ventas
async function loadSales(dateFilter = null) {
    try {
        const container = document.getElementById('ventas-container');
        const loading = document.querySelector('#ventas-section .loading');

        if (loading) {
            loading.style.display = 'block';
            loading.textContent = 'Cargando ventas...';
        }
        if (container) {
            container.style.display = 'none';
        }

        let url = '/api/sales';
        if (dateFilter) {
            url += `?date=${dateFilter}`;
        }

        const sales = await window.ApiClient.apiRequest(url);
        displaySalesTable(sales);

    } catch (error) {
        console.error('Error cargando ventas:', error);
        const loading = document.querySelector('#ventas-section .loading');
        if (loading) {
            loading.textContent = 'Error al cargar ventas. Verifica la conexión con el servidor.';
            loading.style.display = 'block';
        }
    }
}

// Función para filtrar ventas
async function filterSales() {
    const dateInput = document.getElementById('sales-date');
    const startDateInput = document.getElementById('sales-start-date');
    const endDateInput = document.getElementById('sales-end-date');

    const specificDate = dateInput ? dateInput.value : null;
    const startDate = startDateInput ? startDateInput.value : null;
    const endDate = endDateInput ? endDateInput.value : null;

    try {
        let url = '/api/sales';

        if (specificDate) {
            url += `?date=${specificDate}`;
        } else if (startDate && endDate) {
            // Para rango de fechas, necesitamos modificar el endpoint o filtrar en frontend
            // Por ahora, cargamos todas las ventas y filtramos en frontend
            const allSales = await window.ApiClient.apiRequest('/api/sales');
            const filteredSales = allSales.filter(sale => {
                const saleDate = new Date(sale.fecha).toISOString().split('T')[0];
                return saleDate >= startDate && saleDate <= endDate;
            });
            displaySalesTable(filteredSales);
            return;
        } else if (startDate) {
            const allSales = await window.ApiClient.apiRequest('/api/sales');
            const filteredSales = allSales.filter(sale => {
                const saleDate = new Date(sale.fecha).toISOString().split('T')[0];
                return saleDate >= startDate;
            });
            displaySalesTable(filteredSales);
            return;
        } else if (endDate) {
            const allSales = await window.ApiClient.apiRequest('/api/sales');
            const filteredSales = allSales.filter(sale => {
                const saleDate = new Date(sale.fecha).toISOString().split('T')[0];
                return saleDate <= endDate;
            });
            displaySalesTable(filteredSales);
            return;
        }

        const sales = await window.ApiClient.apiRequest(url);
        displaySalesTable(sales);

    } catch (error) {
        console.error('Error filtrando ventas:', error);
        showAlert('Error al filtrar ventas', 'error');
    }
}

// Función para limpiar filtro de ventas
function clearSalesFilter() {
    const dateInput = document.getElementById('sales-date');
    const startDateInput = document.getElementById('sales-start-date');
    const endDateInput = document.getElementById('sales-end-date');

    if (dateInput) dateInput.value = '';
    if (startDateInput) startDateInput.value = '';
    if (endDateInput) endDateInput.value = '';

    loadSales();
}

// Función para mostrar ventas de hoy
function showTodaySales() {
    const today = DateUtils.getCurrentSystemDate().toISOString().split('T')[0];
    const dateInput = document.getElementById('sales-date');
    if (dateInput) {
        dateInput.value = today;
    }
    filterSales();
}

// Función para cargar sección de ventas (lazy loading)
async function loadSalesSection(contentElement) {
    console.log('Cargando sección de ventas (lazy loading)');
    // Cargar ventas por defecto (últimos 7 días para mostrar más datos)
    const endDate = DateUtils.getCurrentSystemDate();
    const startDate = new Date(endDate);
    startDate.setDate(startDate.getDate() - 7);
    const startDateStr = startDate.toISOString().split('T')[0];
    const endDateStr = endDate.toISOString().split('T')[0];

    // Usar filterSales para cargar con rango de fechas
    const dateInput = document.getElementById('sales-start-date');
    const endDateInput = document.getElementById('sales-end-date');
    if (dateInput) dateInput.value = startDateStr;
    if (endDateInput) endDateInput.value = endDateStr;
    await filterSales();
}