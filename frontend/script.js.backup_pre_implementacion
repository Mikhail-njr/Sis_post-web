                historialTable.style.display = 'table';
            }

            // Configurar eventos para el dropdown
            setupCierreDropdownEvents();
        }
    },

    async loadMetricasSection(contentElement) {
        console.log('Cargando sección de métricas (orchestrator)');
        // Las métricas ya se cargan en fetchMetrics
    },

    async loadPromocionesSection(contentElement) {
        console.log('Cargando sección de promociones (orchestrator)');
        try {
            const promociones = await window.ApiClient.apiRequest('/promotions');
            displayPromociones(promociones);
        } catch (error) {
            console.error('Error cargando promociones:', error);
        }
    },

    async loadOperationsLogSection(contentElement) {
        console.log('Cargando sección de registro de operaciones (orchestrator)');
        try {
            await loadOperationsLog();
        } catch (error) {
            console.error('Error cargando registro de operaciones:', error);
        }
    },

    // Forzar refresh de sección específica
    async refreshSection(sectionId) {
        console.log(`🔄 Forzando refresh de sección: ${sectionId}`);
        LoadingSystem.cache.invalidate(sectionId);

        const section = document.getElementById(sectionId);
        if (section) {
            const content = section.querySelector('.section-content');
            if (content) {
                content.setAttribute('data-loaded', 'false');
                await this.loadSection(sectionId, content);
            }
        }
    },

    // Verificar si sección está cargada
    isSectionLoaded(sectionId) {
        return this.sectionsLoaded.has(sectionId);
    },

    // Obtener estado del orchestrator
    getStatus() {
        return {
            initialized: this.initialized,
            criticalDataLoaded: this.criticalDataLoaded,
            sectionsLoaded: Array.from(this.sectionsLoaded),
            activeOperations: LoadingSystem.getActiveOperations()
        };
    }
};

