// Función para manejar el toggle de secciones (desplegable)
function toggleSection(sectionElement) {
    const section = sectionElement;
    const content = section.querySelector('.section-content');
    const isCollapsed = section.classList.contains('collapsed');
    const isLoaded = content.getAttribute('data-loaded') === 'true';

    // Si se está expandiendo y no está cargado, cargar contenido
    if (!isCollapsed && !isLoaded) {
        const sectionId = section.id;
        loadSectionContent(sectionId, content);
        content.setAttribute('data-loaded', 'true');
    }
}

// Función para inicializar carga diferida de secciones del dashboard
function initializeLazyLoading() {
const sectionHeaders = document.querySelectorAll('.section-header');

sectionHeaders.forEach(header => {
    header.addEventListener('click', function() {
        toggleSection(this.parentElement);
    });
});
}

// Función para cargar contenido de secciones específicas
async function loadSectionContent(sectionId, contentElement) {
try {
    const loadingElement = contentElement.querySelector('.loading');
    if (loadingElement) {
        loadingElement.style.display = 'block';
    }

    switch (sectionId) {
        case 'ventas-section':
            await loadSalesSection(contentElement);
            break;
        case 'productos-section':
            await loadProductsSection(contentElement);
            break;
        case 'lotes-section':
