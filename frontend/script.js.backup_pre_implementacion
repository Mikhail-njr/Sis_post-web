// Variable global para controlar el estado de ordenamiento
let currentSortBy = 'stock';
let currentSortOrder = 'desc';

// Función para mostrar tabla de productos
function displayProductsTable(products, sortBy = currentSortBy, sortOrder = currentSortOrder) {
    const container = document.querySelector('#productos-section');
    const table = document.querySelector('#productos-table');
    const loading = container ? container.querySelector('.loading') : null;

    if (!container || !table) {
        console.warn('Productos container or table not found');
        return;
    }

    if (products && products.length > 0) {
        table.style.display = 'table';
        if (loading) loading.style.display = 'none';

        const tbody = table.querySelector('tbody');
        tbody.innerHTML = '';

        // Ordenar productos según los parámetros
        const sortedProducts = [...products].sort((a, b) => {
            let aValue, bValue;

            switch (sortBy) {
                case 'stock':
                    aValue = parseInt(a.stock) || 0;
                    bValue = parseInt(b.stock) || 0;
                    break;
                case 'nombre':
                    aValue = (a.nombre || '').toLowerCase();
                    bValue = (b.nombre || '').toLowerCase();
                    break;
                case 'codigo':
                    aValue = (a.codigo || '').toLowerCase();
                    bValue = (b.codigo || '').toLowerCase();
                    break;
                case 'precio':
                    aValue = parseFloat(a.precio) || 0;
                    bValue = parseFloat(b.precio) || 0;
                    break;
                case 'categoria':
                    aValue = (a.categoria || '').toLowerCase();
                    bValue = (b.categoria || '').toLowerCase();
                    break;
                default:
                    aValue = parseInt(a.stock) || 0;
                    bValue = parseInt(b.stock) || 0;
            }

            if (sortOrder === 'asc') {
                return aValue > bValue ? 1 : aValue < bValue ? -1 : 0;
            } else {
                return aValue < bValue ? 1 : aValue > bValue ? -1 : 0;
            }
        });

        sortedProducts.slice(0, 50).forEach(product => { // Limitar a 50 productos para mejor rendimiento
            const row = document.createElement('tr');
            const stockColor = product.stock <= 5 ? '#dc3545' : product.stock <= 10 ? '#ffc107' : '#28a745';
            const estadoVencimiento = product.estado_vencimiento === 'tiene_vencidos' ? '🚨' :
                                   product.estado_vencimiento === 'proximo_vencer' ? '⚠️' : '✅';

            // Mostrar información de vencimiento
            let vencimientoInfo = '';
            if (product.proximo_vencimiento) {
                vencimientoInfo = DateUtils.formatForDisplay(product.proximo_vencimiento, { dateStyle: 'short' });
            } else {
                vencimientoInfo = product.estado_vencimiento || 'vigente';
            }

            row.innerHTML = `
                <td><input type="checkbox" class="product-select" value="${product.id}"></td>
                <td>${product.id}</td>
                <td>${product.codigo}</td>
                <td>${product.nombre}</td>
                <td>${product.categoria || ''}</td>
                <td>${formatCurrency(product.precio)}</td>
                <td style="color: ${stockColor}; cursor: pointer;" onclick="toggleStockDisplay(this, '${estadoVencimiento} ${vencimientoInfo}', ${product.stock})"><strong>${product.stock}</strong></td>
                <td>${product.cantidad_lotes || 0}</td>
                <td>${estadoVencimiento} ${vencimientoInfo}</td>
                <td>${product.codigo_barras || '-'}</td>
                <td>
                    <button class="edit-button" onclick="editProduct(${product.id})">Editar</button>
                    <button class="btn btn-secondary" onclick="viewProductDetails(${product.id})" style="margin-left: 5px;">Ver</button>
                </td>
            `;
            tbody.appendChild(row);
        });

    } else {
        table.style.display = 'none';
        if (loading) {
            loading.textContent = 'No hay productos registrados.';
            loading.style.display = 'block';
        }
    }
}

// Función para alternar la visualización de stock/vencimiento (usa el mismo evento desplegable)
function toggleStockDisplay(cell, expirationInfo, stockNumber) {
    if (cell.innerHTML.includes('status-badge')) {
        // Si ya muestra vencimiento, volver a mostrar stock
        cell.innerHTML = `<strong>${stockNumber}</strong>`;
        cell.style.color = stockNumber <= 5 ? '#dc3545' : stockNumber <= 10 ? '#ffc107' : '#28a745';
    } else {
        // Mostrar información de vencimiento
        cell.innerHTML = expirationInfo;
        cell.style.color = '#000000';
    }
}

// Función para alternar el modo de ordenamiento
function toggleSortMode() {
    // Definir las opciones de ordenamiento disponibles
    const sortOptions = [
        { by: 'stock', order: 'desc', label: '📊 Stock ↓' },
        { by: 'stock', order: 'asc', label: '📊 Stock ↑' },
        { by: 'nombre', order: 'asc', label: '📊 Nombre A-Z' },
        { by: 'codigo', order: 'asc', label: '📊 Código A-Z' },
        { by: 'precio', order: 'desc', label: '📊 Precio ↓' },
        { by: 'categoria', order: 'asc', label: '📊 Categoría A-Z' }
    ];

    // Encontrar el índice actual
    let currentIndex = 0;
    for (let i = 0; i < sortOptions.length; i++) {
        if (sortOptions[i].by === currentSortBy && sortOptions[i].order === currentSortOrder) {
            currentIndex = i;
            break;
        }
    }

    // Avanzar al siguiente modo de ordenamiento
    const nextIndex = (currentIndex + 1) % sortOptions.length;
    const nextOption = sortOptions[nextIndex];

    // Actualizar variables globales
    currentSortBy = nextOption.by;
    currentSortOrder = nextOption.order;

    // Actualizar texto del botón
    const sortBtn = document.getElementById('sortBtn');
    if (sortBtn) {
        sortBtn.innerHTML = nextOption.label;
    }

    // Re-ordenar y mostrar la tabla
    if (window.dashboardData && window.dashboardData.products) {
        displayProductsTable(window.dashboardData.products, currentSortBy, currentSortOrder);
    }

    // Asegurar que la sección esté visible
    const productosSection = document.getElementById('productos-section');
    if (productosSection && productosSection.classList.contains('collapsed')) {
        toggleSection(productosSection);
    }
}

