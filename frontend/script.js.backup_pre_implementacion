// Alias para compatibilidad con código existente
const DashboardCache = {
    get() { return LoadingSystem.cache.get('dashboard'); },
    set(data) { LoadingSystem.cache.set('dashboard', data); },
    isValid() { return LoadingSystem.cache.isValid('dashboard'); },
    invalidate() { LoadingSystem.cache.invalidate('dashboard'); },
    clear() { LoadingSystem.cache.clear('dashboard'); },
    loadFromStorage() { return LoadingSystem.cache.loadFromStorage('dashboard'); },
    updateStatus() {
        const statusDiv = document.getElementById('cache-status');
        if (!statusDiv) return;

        if (this.isValid()) {
            const remaining = Math.ceil((LoadingSystem.cache.CACHE_DURATION - (Date.now() - LoadingSystem.cache.timestamps.get('dashboard'))) / 1000 / 60);
            statusDiv.textContent = `📊 Datos actualizados (${remaining}min restantes)`;
            statusDiv.style.color = '#28a745';
        } else {
            statusDiv.textContent = '📊 Datos desactualizados';
            statusDiv.style.color = '#ffc107';
        }
    },
    invalidateOnChange() {
        console.log('🔄 Invalidando caché por cambios en datos');
        this.invalidate();
        setTimeout(() => {
            LoadingSystem.executeOperation('refresh-dashboard', () => fetchMetrics(true), {
                showGlobalLoader: true,
                globalLoaderText: 'Actualizando datos...'
            });
        }, 1000);
    },
    refresh() {
        return LoadingSystem.executeOperation('refresh-dashboard', () => fetchMetrics(true), {
            showGlobalLoader: true,
            globalLoaderText: 'Actualizando datos...'
        });
    }
};

// Función para procesar y mostrar datos del dashboard
function processDashboardData(dashboardData) {
    // Mostrar productos más vendidos
    const topProductsTable = document.getElementById('top-products-table');
    if (topProductsTable) {
        const tbody = topProductsTable.querySelector('tbody');
        tbody.innerHTML = '';

        if (dashboardData.topProducts && dashboardData.topProducts.length > 0) {
            dashboardData.topProducts.forEach((product, index) => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${index + 1}</td>
                    <td>${product.nombre}</td>
                    <td>${product.codigo}</td>
                    <td>${product.total_vendido}</td>
                `;
                tbody.appendChild(row);
            });
        }
    }

    // Mostrar historial de cierres
    const historialTable = document.getElementById('historial-cierres-table');
    if (historialTable) {
        const tbody = historialTable.querySelector('tbody');
        tbody.innerHTML = '';

        if (dashboardData.cierres && dashboardData.cierres.length > 0) {
            // Poblar el dropdown de cierres
            const cierreSelect = document.getElementById('cierre-select');
            if (cierreSelect) {
                // Solo poblar si no tiene opciones ya (evitar sobreescribir)
                if (cierreSelect.options.length <= 1) { // Solo la opción por defecto
                    cierreSelect.innerHTML = '<option value="">Seleccionar cierre...</option>';
                    dashboardData.cierres.forEach((cierre, index) => {
                        const option = document.createElement('option');
                        option.value = index; // Usar índice como valor
                        option.textContent = `${DateUtils.formatForDisplay(cierre.fecha)} - ${formatCurrency(cierre.total_esperado)} (${cierre.cantidad_ventas} ventas)`;
                        option.dataset.cierreData = JSON.stringify(cierre); // Guardar datos del cierre
                        cierreSelect.appendChild(option);
                    });
                }
            }

            dashboardData.cierres.forEach((cierre, index) => {
                const row = document.createElement('tr');
                row.dataset.cierreIndex = index; // Agregar índice para referencia
                row.innerHTML = `
                    <td>${DateUtils.formatForDisplay(cierre.fecha)}</td>
                    <td>${formatCurrency(cierre.dinero_inicial)}</td>
                    <td>${formatCurrency(cierre.total_ventas)}</td>
                    <td>${formatCurrency(cierre.total_esperado)}</td>
                    <td>${formatCurrency(cierre.diferencia)}</td>
                    <td>${cierre.cantidad_ventas}</td>
                `;
                tbody.appendChild(row);
            });
            historialTable.style.display = 'table';

            // Configurar eventos para el dropdown si no están configurados
            if (cierreSelect && !cierreSelect.hasAttribute('data-events-setup')) {
                setupCierreDropdownEvents();
                cierreSelect.setAttribute('data-events-setup', 'true');
            }
        }
        document.querySelector('#historial-cierres-section .loading').style.display = 'none';
    }

    // Mostrar alertas de vencimiento usando datos del dashboard
    if (dashboardData.expiringSoon || dashboardData.expired) {
        displayExpirationAlerts(dashboardData.expiringSoon || [], dashboardData.expired || []);
    }

    // Mostrar productos con stock bajo usando datos del dashboard
    if (dashboardData.products) {
        const lowStockProducts = dashboardData.products.filter(p => p.stock <= 5 && p.stock > 0);
        if (lowStockProducts.length > 0) {
            displayLowStockAlerts(lowStockProducts);
        }
    }

    // Almacenar datos globales para otras funciones que puedan necesitarlos
    window.dashboardData = dashboardData;
}

// Función unificada de login para todo el sistema
function unifiedLogin(message = 'Usuario requerido para acceder al sistema POS:') {
    return new Promise((resolve) => {
        showLoginModal(() => {
            resolve(true);
        });
    });
}

// Funciones de autenticación
async function login() {
    try {
        await unifiedLogin('Usuario:');
        updateUIBasedOnAuth(); // Actualizar la UI después del login exitoso
        showAlert('✅ Sesión iniciada correctamente', 'success');
        return true;
    } catch (error) {
        showAlert('❌ Error en el inicio de sesión', 'error');
        return false;
    }
}

function logout() {
    authCredentials = null;
    isLoggedIn = false;
    sessionStorage.removeItem('authCredentials');
    updateUIBasedOnAuth();
    showAlert('👋 Sesión cerrada', 'success');
}

async function accessDashboard() {
    if (!isLoggedIn) {
        if (await login()) {
            window.location.href = 'dashboard.html';
        }
    } else {
        window.location.href = 'dashboard.html';
    }
}

function updateUIBasedOnAuth() {
    const loginBtn = document.getElementById('loginBtn');
    const dashboardBtn = document.getElementById('dashboardBtn');
    const payBtn = document.getElementById('payBtn');

    if (loginBtn) {
        loginBtn.textContent = isLoggedIn ? 'Cerrar Sesión' : 'Iniciar Sesión';
        loginBtn.onclick = isLoggedIn ? logout : login;
    }

    if (dashboardBtn) {
        dashboardBtn.style.display = 'inline-block'; // Siempre visible
    }

    if (payBtn) {
        payBtn.disabled = !isLoggedIn;
        payBtn.textContent = isLoggedIn ? 'Pagar' : 'Simular Pago';
        payBtn.onclick = isLoggedIn ? () => {
            // Use the local processPayment function if it exists, otherwise use the global one
            if (typeof window.processPayment === 'function') {
                window.processPayment();
            } else {
                processPayment();
            }
        } : () => {
            // Use the local simulatePayment function if it exists, otherwise use the global one
            if (typeof window.simulatePayment === 'function') {
                window.simulatePayment();
            } else {
                simulatePayment();
            }
        };
    }
}

function simulatePayment() {
    if (cart.length === 0) {
        showAlert('❌ El carrito está vacío', 'error');
        return;
    }

    if (!selectedPaymentMethod) {
        showAlert('❌ Por favor selecciona un método de pago', 'error');
        return;
    }

    // Calcular total
    const total = cart.reduce((sum, item) => sum + (parseFloat(item.precio) * item.quantity), 0);

    // Generar factura simulada detallada
    const invoiceNumber = `SIM-${Date.now()}`;
    let invoiceDetails = `🎭 SIMULACIÓN DE COMPRA\n\n`;
    invoiceDetails += `Factura: ${invoiceNumber}\n`;
    invoiceDetails += `Fecha: ${DateUtils.formatForDisplay(new Date().toISOString())}\n`;

    // Formatear método de pago
    let paymentMethodText = 'No especificado';
    if (selectedPaymentMethod) {
        paymentMethodText = selectedPaymentMethod.toUpperCase();
    }
    invoiceDetails += `Método de Pago: ${paymentMethodText}\n\n`;
    invoiceDetails += `PRODUCTOS:\n`;

    cart.forEach((item, index) => {
        const subtotal = parseFloat(item.precio) * item.quantity;
        invoiceDetails += `${index + 1}. ${item.nombre}\n`;
        invoiceDetails += `   Código: ${item.codigo}\n`;
        invoiceDetails += `   Cantidad: ${item.quantity} × ${formatCurrency(item.precio)} = ${formatCurrency(subtotal)}\n\n`;
    });

    invoiceDetails += `TOTAL: ${formatCurrency(total)}\n\n`;
    invoiceDetails += `⚠️ ESTA ES UNA SIMULACIÓN - No se procesó ningún pago real`;

    // Mostrar factura en alert
    alert(invoiceDetails);

    // Limpiar carrito
    cart = [];
    updateCart();

    // Limpiar carrito (ya se hace arriba)
    // cart = [];
    // updateCart();
}

// Cargar credenciales al iniciar
function loadAuthFromStorage() {
    const stored = sessionStorage.getItem('authCredentials');
    if (stored) {
        authCredentials = JSON.parse(stored);
        isLoggedIn = true;
    }
    updateUIBasedOnAuth();

    // Verificar si hay un producto escaneado pendiente
    checkScannedProduct();
}

// Función para verificar productos escaneados desde el escáner
function checkScannedProduct() {
    const scannedProduct = sessionStorage.getItem('scannedProduct');
    if (scannedProduct) {
        try {
            const product = JSON.parse(scannedProduct);
            // Verificar que no haya expirado (5 minutos máximo)
            if (Date.now() - product.timestamp < 5 * 60 * 1000) {
                // Agregar automáticamente al carrito
                const existing = cart.find(item => item.id === product.id);
                if (existing) {
                    existing.quantity += 1;
                } else {
                    cart.push({
                        id: product.id,
                        nombre: product.nombre,
                        precio: product.precio,
                        codigo: product.codigo,
                        quantity: 1
                    });
                }
                updateCart();
                showAlert(`✅ "${product.nombre}" escaneado y agregado al carrito`, 'success');
            }
            sessionStorage.removeItem('scannedProduct');
        } catch (e) {
            console.error('Error procesando producto escaneado:', e);
            sessionStorage.removeItem('scannedProduct');
        }
    }
}

