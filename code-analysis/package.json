{
  "name": "pos-code-analysis",
  "version": "1.0.0",
  "description": "Sistema de análisis de código para Sistema POS usando Qdrant",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "simple-server": "node simple-server.js",
    "init-collections": "node scripts/init-collections.js",
    "index-codebase": "node scripts/index-codebase.js",
    "analyze-file": "node scripts/analyze-file.js",
    "test": "node test/analysis.test.js",
    "qdrant:start": "start-qdrant-optimized.bat",
    "qdrant:stop": "docker stop qdrant-pos",
    "qdrant:restart": "docker restart qdrant-pos",
    "qdrant:logs": "docker logs -f qdrant-pos",
    "system:start": "npm run qdrant:start && timeout /t 10 && npm run simple-server",
    "system:start-max": "npm run qdrant:start && timeout /t 10 && optimize-node.bat",
    "system:maximum-power": "maximum-power.bat",
    "system:health": "curl -s http://localhost:3001/health && echo. && curl -s http://localhost:6333/health",
    "optimize:node": "optimize-node.bat",
    "test:load": "test-high-load.bat"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.7.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.13.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "glob": "^10.5.0",
    "sqlite3": "^5.1.6",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "code-analysis",
    "qdrant",
    "embeddings",
    "pos-system",
    "ai-assistant"
  ],
  "author": "Sistema POS",
  "license": "MIT"
}
